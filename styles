    ),
    course AS
    (
      SELECT VALUTA_ALL_ID AS VALUTA_ID, SCALE, RATE, COURSE_DATE
      FROM
      (
        SELECT cr.*,
               ROW_NUMBER() OVER (PARTITION BY cr.VALUTA_ALL_ID
                                  ORDER BY cr.COURSE_DATE DESC, cr.CREATE_DATE DESC) AS z
          FROM prm_dt,
               DWKR_02.COURSE_NBRB_MV cr
          WHERE cr.COURSE_DATE < prm_dt.REPORTING_DATE
      )
      WHERE z=1
      ORDER BY VALUTA_ALL_ID
    )
  SELECT 
    L_REPORT_ID, -- REPORT_ID, --              NUMBER(38,0),
    t2.BASIS_ACTIVITY_ID, -- BASIS_ACTIVITY_ID, --      NUMBER(38,0),
    CASE
      WHEN t2.BASIS_ACTIVITY_ID = 999
        THEN ' '
      ELSE ba.BASIS_ACTIVITY_CODE
    END AS BASIS_ACTIVITY_CODE, --NULL, -- BASIS_ACTIVITY_CODE, --    VARCHAR(1),
    t2.BANK_ID, -- BANK_ID, --                NUMBER(9, 0),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = 1 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_0M_1M, --    NUMBER(34,3),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = 3 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_1M_3M, --    NUMBER(34,3),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = 6 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_3M_6M, --    NUMBER(34,3),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = 12 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_6M_12M, --   NUMBER(34,3),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = 24 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_1Y_2Y, --    NUMBER(34,3),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = 36 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_2Y_3Y, --    NUMBER(34,3),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = 60 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_3Y_5Y, --    NUMBER(34,3),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = 61 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_MORE_5Y, --  NUMBER(34,3),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = 1000 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_IS_NULL, --  NUMBER(34,3),
    SUM(CASE WHEN KD_TERM_MONTHS_GROUP = -1 THEN MAIN_DEBT_BYN ELSE 0 END) AS MAIN_DEBT_BYN_KD_TERM_LESS_0, --   NUMBER(34,3),
    b.SHORT_NAME AS BANK_NAME, -- NULL, -- BANK_NAME, --              VARCHAR(100),
    CASE
      WHEN t2.BASIS_ACTIVITY_ID = 999
        THEN 'Код ВЭД отсутствует'
      WHEN t2.BASIS_ACTIVITY_ID IS NULL
        THEN 'Итого, по всем видам деятельности'
      ELSE ba.BASIS_ACTIVITY_NAME
    END AS BASIS_ACTIVITY_NAME, --NULL, -- BASIS_ACTIVITY_CODE, --    VARCHAR(1),
    NULL, -- CLIENT_CODE, --            NUMBER(1, 0),
    NULL -- CLIENT_TYPE_NAME, --       VARCHAR(20),
  FROM
    (
      SELECT  COALESCE(BASIS_ACTIVITY_ID,999) AS BASIS_ACTIVITY_ID,
              BANK_ID,
              KD_TERM_MONTHS_GROUP,
              COUNT(*),
              COUNT(DISTINCT KRED_DOG_ID),
              COUNT(DISTINCT BORR_ID),
              SUM(MAIN_DEBT_BYN) AS MAIN_DEBT_BYN
      FROM
      (
        SELECT
              kd_act_flt_cr.*,
              kdf.END_DATE_OSN,
              ((kdf.END_DATE_OSN - kd_act_flt_cr.KRED_DOG_DATE)+1) AS KD_TERM_DAYS,
              ((kdf.END_DATE_OSN - prm_dt.REPORTING_DATE)+1) AS REMAINING_TERM_DAYS,
              (MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, kd_act_flt_cr.KRED_DOG_DATE)) AS KD_TERM_MONTHS,
               CASE
                  WHEN MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) >=  0
                   AND MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) <=  1
                    THEN 1 -- '0M_1M'
                  WHEN MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) >   1
                   AND MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) <=  3
                    THEN 3 -- '1M_3M'
                  WHEN MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) >   3
                   AND MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) <=  6
                    THEN 6 -- '3M_6M'
                  WHEN MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) >   6
                   AND MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) <= 12
                    THEN 12 -- '6M_12M'
                  WHEN MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) >  12
                   AND MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) <= 24
                    THEN 24 -- '1Y_2Y'
                  WHEN MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) >  24
                   AND MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) <= 36
                    THEN 36 -- '2Y_3Y'
                  WHEN MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) >  36
                   AND MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) <= 60
                    THEN 60 -- '3Y_5Y'
                  WHEN MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) >  60
                    THEN 61 -- 'MORE_5Y'
                  WHEN kdf.END_DATE_OSN IS NULL
                    THEN 1000  -- 'EMPTY_TERM'
                  WHEN MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, in_DATE) <   0
                    THEN -1 -- 'LESS_0'
               END AS KD_TERM_MONTHS_GROUP,
              (MONTHS_BETWEEN(kdf.END_DATE_OSN + 1, prm_dt.REPORTING_DATE)) AS REMAINING_TERM_MONTHS,
             -- (COALESCE(kdis_byn.REMAINING_DEBT,0) +
             -- COALESCE(kdisf_byn.REMAINING_DEBT_FCTR_UNDSCL_SUM,0) +
             -- COALESCE(lt1_byn.OVRD_REST_1,0) +
             -- COALESCE(lt6_byn.OVRD_REST_6,0) +
             -- COALESCE(lt7_byn.OVRD_REST_7,0) +
             -- COALESCE(lt8_byn.OVRD_REST_8,0) +
             -- COALESCE(lt10_byn.OVRD_REST_10,0) +
             -- COALESCE(lt11_byn.OVRD_REST_11,0)) AS MAIN_DEBT_BYN
              CASE
                WHEN kd_act_flt_cr.KRED_TYPE_ID IN (1,2,3,10) THEN -- кредиты, коммерческие займы
                  CASE
                    WHEN kdis_byn.REMAINING_DEBT IS NULL AND lt1_byn.OVRD_REST_1 IS NULL THEN NULL
                    ELSE COALESCE(kdis_byn.REMAINING_DEBT,0) + COALESCE(lt1_byn.OVRD_REST_1,0)
                  END
                WHEN kd_act_flt_cr.KRED_TYPE_ID IN (7) THEN -- лизинг
                  CASE
                    WHEN kdis_byn.REMAINING_DEBT IS NULL AND lt6_byn.OVRD_REST_6 IS NULL THEN NULL
                    ELSE COALESCE(kdis_byn.REMAINING_DEBT,0) + COALESCE(lt6_byn.OVRD_REST_6,0)
                  END
                WHEN kd_act_flt_cr.KRED_TYPE_ID IN (8) THEN -- факторинг
                  CASE
					WHEN kdis_byn.REMAINING_DEBT IS NULL AND lt7_byn.OVRD_REST_7 IS NULL AND lt10_byn.OVRD_REST_10 IS NULL THEN NULL
					ELSE COALESCE(kdis_byn.REMAINING_DEBT, 0)
						+ COALESCE(lt7_byn.OVRD_REST_7, 0) -- у кредитора
						+ COALESCE(lt10_byn.OVRD_REST_10, 0) -- у должника
                  END
                WHEN kd_act_flt_cr.KRED_TYPE_ID IN (9) THEN -- факторинговые операции
                  CASE
                   WHEN kdis_byn.REMAINING_DEBT IS NULL AND lt11_byn.OVRD_REST_11 IS NULL THEN NULL
                    ELSE COALESCE(kdis_byn.REMAINING_DEBT,0) + COALESCE(lt11_byn.OVRD_REST_11,0)
                  END
              END AS MAIN_DEBT_BYN
        FROM prm_dt,
         ( SELECT DISTINCT kd_act.*
           FROM kd_act
                INNER JOIN
                kd_act_crncy
                ON kd_act.BORR_ID = kd_act_crncy.BORR_ID AND kd_act.KRED_DOG_ID = kd_act_crncy.KRED_DOG_ID
         )
         kd_act_flt_cr
         LEFT OUTER JOIN
         DWKR_02.KRED_DOG_FUTURE_AE kdf
         ON kd_act_flt_cr.BORR_ID = kdf.BORR_ID AND kd_act_flt_cr.KRED_DOG_ID = kdf.KRED_DOG_ID
    
          LEFT OUTER JOIN
----

