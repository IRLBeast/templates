CREATE OR REPLACE
PACKAGE BODY DWKR_02.REPORT_FS10 AS

  FUNCTION GET_FS10_RESULT(IN_REPORT_ID NUMBER)
           RETURN REPORT_FS10_RESULT_TBL_TP
    PIPELINED
    IS
      CURSOR cur IS
        SELECT
          ID,
          REPORT_ID, --              NUMBER(38,0),
          RISK_GROUP_ID_BEGIN, --	  NUMBER(38,0),
          BANK_ID, --                NUMBER(9, 0),
          CLIENT_CODE, --            NUMBER(1, 0),
          BASIS_ACTIVITY_ID, --      NUMBER(38,0),
          BASIS_ACTIVITY_CODE, --    VARCHAR(1),
          ROUND(MAIN_DEBT_BYN_RISK_GROUP_1_END/1000, 1) AS MAIN_DEBT_BYN_RISK_GROUP_1_END, --    NUMBER(34,3),
          ROUND(MAIN_DEBT_BYN_RISK_GROUP_2_END/1000, 1) AS MAIN_DEBT_BYN_RISK_GROUP_2_END, --    NUMBER(34,3),
          ROUND(MAIN_DEBT_BYN_RISK_GROUP_3_END/1000, 1) AS MAIN_DEBT_BYN_RISK_GROUP_3_END, --    NUMBER(34,3),
          ROUND(MAIN_DEBT_BYN_RISK_GROUP_4_END/1000, 1) AS MAIN_DEBT_BYN_RISK_GROUP_4_END, --    NUMBER(34,3),
          ROUND(MAIN_DEBT_BYN_RISK_GROUP_5_END/1000, 1) AS MAIN_DEBT_BYN_RISK_GROUP_5_END, --    NUMBER(34,3),
          ROUND(MAIN_DEBT_BYN_RISK_GROUP_6_END/1000, 1) AS MAIN_DEBT_BYN_RISK_GROUP_6_END, --    NUMBER(34,3),
          RISK_GROUP_NAME_BEGIN, --  VARCHAR2(250),
          BANK_NAME, --              VARCHAR(255),
          CLIENT_TYPE_NAME, --       VARCHAR(20),
          BASIS_ACTIVITY_NAME --    VARCHAR(255)
        FROM DWKR_02.REPORT_FS10_RESULT
        WHERE REPORT_ID = IN_REPORT_ID
        ORDER BY ID;

  BEGIN

    FOR rec IN cur
    LOOP
      PIPE ROW(rec);
    END LOOP;
    RETURN;

  END GET_FS10_RESULT;


PROCEDURE PROC_FS10
/*
  Процедура выполняет отчет FS10 - 
  Конечная цель процедуры - формирование таблиц DWKR_02.FS10_RESULT
*/
 (
    in_DATE_RANGE_BEGIN DATE, -- Начальная дата диапазона
    in_DATE_RANGE_END DATE,   -- Конечная дата диапазона
    in_MIN_CONTRACT_TERM IN NUMBER, -- Минимальный срок действия договора (количество лет)
    in_MAX_CONTRACT_TERM IN NUMBER, -- Максимальный срок действия договора (количество лет)
    in_MIN_CONTRACT_EXPIRATION_TERM IN NUMBER, -- Минимальный оставшийся срок до конца срока действия договора (количество лет)
    in_MAX_CONTRACT_EXPIRATION_TERM IN NUMBER, -- Максимальный оставшийся срок до конца срока действия договора (количество лет)
    in_BANK_ID IN NUMBER, -- Идентификатор участника АИС КР (источника формирования КИ)
    in_CRED_HIST_SOURCE_GROUP_ID_TBL IN DWKR_02.ID_TBL_TP DEFAULT NULL, -- Идентификаторы групп источников формирования кредитной истории (NULL - все группы)
    in_CONTRACT_TYPE_ID_TBL IN DWKR_02.ID_TBL_TP,  -- Виды договоров (1,2,3,7,8,9,10), (NULL - все виды договоров кредитного характера)
    in_CURRENCY_TYPE IN NUMBER, -- признак валюты задолженности (национальная / иностранная / все)
    in_CURRENCY_ID_TBL IN DWKR_02.ID_TBL_TP,  -- Цифровые коды валют, (NULL - все валюты)
    in_BORR_TYPE_ID IN NUMBER DEFAULT NULL,   -- Признак физ.лицо (0) / юр.лицо (1) / NULL - все
    in_BASIS_ACTIVITY_CODE_TBL IN DWKR_02.CHAR_TBL_TP,  -- Вид деятельности '('A'/'Q'/'A, ,...,Q'/...), (NULL - все виды)
    in_RISK_GROUP_REASON_ID_TBL IN DWKR_02.ID_TBL_TP,  -- Перечень оснований для классификации по группам риска, (NULL - все виды оснований)
    OUT_REPORT_ID OUT NUMBER
 )
IS
  lCONTRACT_TYPE_COUNT NUMBER DEFAULT 0;
  lCONTRACT_TYPE_STR VARCHAR2(256) DEFAULT ''; 

  L_CURRENCY_ID_COUNT NUMBER DEFAULT 0;
  L_CURRENCY_ID_STR VARCHAR2(256) DEFAULT '';

  L_BASIS_ACTIVITY_COUNT NUMBER DEFAULT 0;
  L_BASIS_ACTIVITY_STR VARCHAR2(1024) DEFAULT '';

  L_REPORT_ID NUMBER DEFAULT NULL;

  L_LOG_FILE_NAME VARCHAR2(256) DEFAULT 'LOG_default.log';

BEGIN
  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' Started');

  SELECT COUNT(*),
        LISTAGG(TO_CHAR(ID), ',') WITHIN GROUP (ORDER BY ID)
  INTO lCONTRACT_TYPE_COUNT,
       lCONTRACT_TYPE_STR
  FROM TABLE(in_CONTRACT_TYPE_ID_TBL);

  SELECT COUNT(*),
        LISTAGG(TO_CHAR(ID), ',') WITHIN GROUP (ORDER BY ID)
  INTO L_CURRENCY_ID_COUNT,
       L_CURRENCY_ID_STR
  FROM TABLE(IN_CURRENCY_ID_TBL);

  SELECT COUNT(*),
        LISTAGG(CODE, ',') WITHIN GROUP (ORDER BY CODE)
  INTO L_BASIS_ACTIVITY_COUNT,
       L_BASIS_ACTIVITY_STR
  FROM TABLE(in_BASIS_ACTIVITY_CODE_TBL);

    -- in_DATE => '''||in_DATE||''',

  -- лог входящих параметров отчета FS10
  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_FS10',LOG_STR => SYSTIMESTAMP||'
  BEGIN
    DWKR_02.PROC_FS10
    (
    in_DATE_RANGE_BEGIN => '''||in_DATE_RANGE_BEGIN||''',
    in_DATE_RANGE_END => '''||in_DATE_RANGE_END||''',
    lCONTRACT_TYPE_COUNT => '||lCONTRACT_TYPE_COUNT||',
    lCONTRACT_TYPE_STR => '''||lCONTRACT_TYPE_STR||''',
    in_CURRENCY_TYPE => '||in_CURRENCY_TYPE||',
    L_CURRENCY_ID_COUNT => '||L_CURRENCY_ID_COUNT||',
    L_CURRENCY_ID_STR => '''||L_CURRENCY_ID_STR||''',
    L_BASIS_ACTIVITY_COUNT => '||L_BASIS_ACTIVITY_COUNT||',
    L_BASIS_ACTIVITY_STR => '''||L_BASIS_ACTIVITY_STR||'''
    );
  END;
  /'
  );

  ----------------------------------------------------------------------------------
  INSERT INTO DWKR_02.REPORT(REPORT_NAME)
  VALUES('FS10')
  RETURNING REPORT_ID INTO L_REPORT_ID;

  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT');
  ----------------------------------------------------------------------------------

--  ----------------------------------------------------------------------------------
--  -- DATE
--  INSERT INTO DWKR_02.REPORT_PARAM_REPORTING_DATE(REPORT_ID, REPORTING_DATE)
--  VALUES(L_REPORT_ID, in_DATE);
--
--  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT_PARAM_REPORTING_DATE');
--  ----------------------------------------------------------------------------------

  ----------------------------------------------------------------------------------
  -- DATE_RANGE
  INSERT INTO DWKR_02.REPORT_PARAM_DATE_RANGE(REPORT_ID, DATE_BEGIN, DATE_END)
  VALUES(L_REPORT_ID, in_DATE_RANGE_BEGIN, in_DATE_RANGE_END);

  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT_PARAM_DATE_RANGE');
  ----------------------------------------------------------------------------------

  ----------------------------------------------------------------------------------
  -- BANK
  -- in_BANK_ID NUMBER, -- Идентификатор участника АИС КР

  IF in_BANK_ID IS NOT NULL THEN
    INSERT INTO DWKR_02.REPORT_PARAM_BANK(REPORT_ID, BANK_ID)
    VALUES(L_REPORT_ID, in_BANK_ID);

    DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT_PARAM_BANK');
  END IF;

  ----------------------------------------------------------------------------------

  ----------------------------------------------------------------------------------
  -- KRED_TYPE
  IF in_CONTRACT_TYPE_ID_TBL IS NOT NULL THEN
    INSERT INTO DWKR_02.REPORT_PARAM_KRED_TYPE(REPORT_ID, KRED_TYPE_ID)
    --  SELECT L_REPORT_ID, ID FROM TABLE(in_KRED_TYPE_ID_TBL);
      SELECT DISTINCT L_REPORT_ID, KRED_TYPE_ID FROM DWKR_02.KRED_TYPE_A
      WHERE KRED_TYPE_ID IN (SELECT ID FROM TABLE(in_CONTRACT_TYPE_ID_TBL));
  END IF;

  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT_PARAM_KRED_TYPE');
  ----------------------------------------------------------------------------------
 
  ----------------------------------------------------------------------------------
  -- CURRENCY_TYPE
  IF in_CURRENCY_TYPE IS NOT NULL THEN
      INSERT INTO DWKR_02.REPORT_PARAM_CURRENCY_TYPE(REPORT_ID, CURRENCY_TYPE_ID)
      VALUES(L_REPORT_ID, in_CURRENCY_TYPE);
  END IF;

  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT_PARAM_CURRENCY_TYPE');
  ----------------------------------------------------------------------------------

  ----------------------------------------------------------------------------------
  -- CURRENCY_ID
  IF in_CURRENCY_ID_TBL IS NOT NULL THEN
    INSERT INTO DWKR_02.REPORT_PARAM_CURRENCY(REPORT_ID, CURRENCY_ID)
      --  SELECT L_REPORT_ID, ID FROM TABLE(in_CURRENCY_ID_TBL);
      SELECT DISTINCT L_REPORT_ID, VALUTA_ID FROM DWKR_02.V_VALUTA
      WHERE VALUTA_ID IN (SELECT ID FROM TABLE(in_CURRENCY_ID_TBL));
  END IF;

  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT_PARAM_CURRENCY');
  ----------------------------------------------------------------------------------

  ----------------------------------------------------------------------------------

  -- CRED_HIST_SOURCE_GROUP
  IF in_CRED_HIST_SOURCE_GROUP_ID_TBL IS NOT NULL THEN
    INSERT INTO DWKR_02.REPORT_PARAM_CRED_HIST_SOURCE_GROUP(REPORT_ID, CRED_HIST_SOURCE_GROUP_ID)
      SELECT DISTINCT L_REPORT_ID, CRED_HIST_SOURCE_GROUP_ID FROM DWKR_02.V_CRED_HIST_SOURCE_GROUP_DATE_RANGE_LATEST
      WHERE CRED_HIST_SOURCE_GROUP_ID IN (SELECT ID FROM TABLE(in_CRED_HIST_SOURCE_GROUP_ID_TBL));
  END IF;

  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS6.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT_PARAM_CRED_HIST_SOURCE_GROUP');

  ----------------------------------------------------------------------------------

  ----------------------------------------------------------------------------------
  -- BORR_TYPE

  IF in_BORR_TYPE_ID IS NOT NULL THEN
    INSERT INTO DWKR_02.REPORT_PARAM_BORR_TYPE(REPORT_ID, BORR_TYPE_ID)
    VALUES(L_REPORT_ID, in_BORR_TYPE_ID);

    DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT_PARAM_BORR_TYPE');
  END IF;

  ----------------------------------------------------------------------------------

  ----------------------------------------------------------------------------------
  -- BASIS_ACTIVITY
  IF in_BASIS_ACTIVITY_CODE_TBL IS NOT NULL THEN
      INSERT INTO DWKR_02.REPORT_PARAM_BASIS_ACTIVITY(REPORT_ID, BASIS_ACTIVITY_ID, BASIS_ACTIVITY_CODE)
        SELECT DISTINCT L_REPORT_ID, BASIS_ACTIVITY_ID, BASIS_ACTIVITY_CODE FROM DWKR_02.V_BASIS_ACTIVITY
        WHERE BASIS_ACTIVITY_CODE IN (SELECT CODE FROM TABLE(in_BASIS_ACTIVITY_CODE_TBL));
  END IF;

  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' DWKR_02.REPORT_PARAM_BASIS_ACTIVITY');
  ----------------------------------------------------------------------------------



  INSERT INTO DWKR_02.REPORT_FS10_RESULT
  (
    -- ID                     NUMBER(38,0) NOT NULL,
    REPORT_ID, --              NUMBER(38,0),
    RISK_GROUP_ID_BEGIN, --	  NUMBER(38,0),
    BANK_ID, --                NUMBER( 9,0),
    CLIENT_CODE, --            NUMBER( 1,0),
    BASIS_ACTIVITY_ID, --      NUMBER(38,0),
    BASIS_ACTIVITY_CODE, --    VARCHAR2(1),
    MAIN_DEBT_BYN_RISK_GROUP_1_END, --    NUMBER(34,3),
    MAIN_DEBT_BYN_RISK_GROUP_2_END, --    NUMBER(34,3),
    MAIN_DEBT_BYN_RISK_GROUP_3_END, --    NUMBER(34,3),
    MAIN_DEBT_BYN_RISK_GROUP_4_END, --    NUMBER(34,3),
    MAIN_DEBT_BYN_RISK_GROUP_5_END, --    NUMBER(34,3),
    MAIN_DEBT_BYN_RISK_GROUP_6_END, --    NUMBER(34,3),
    RISK_GROUP_NAME_BEGIN, --  VARCHAR2(250),
    BANK_NAME, --              VARCHAR2(255),
    CLIENT_TYPE_NAME, --       VARCHAR2(20),
    BASIS_ACTIVITY_NAME --    VARCHAR2(255),
  )
  WITH 
    --prm_dt AS 
    --( SELECT REPORT_ID, REPORTING_DATE
    --  FROM DWKR_02.REPORT_PARAM_REPORTING_DATE
    --  WHERE REPORT_ID = L_REPORT_ID
    --),
    prm_dt_range AS 
    (SELECT REPORT_ID, DATE_BEGIN, DATE_END
     FROM DWKR_02.REPORT_PARAM_DATE_RANGE
     WHERE REPORT_ID = L_REPORT_ID
    ),
    prm_kt AS
    ( SELECT REPORT_ID, KRED_TYPE_ID
      FROM DWKR_02.REPORT_PARAM_KRED_TYPE
      WHERE REPORT_ID = L_REPORT_ID
    ),
    prm_base_act AS
    (
      SELECT L_REPORT_ID AS REPORT_ID, v.BASIS_ACTIVITY_ID, v.BASIS_ACTIVITY_CODE
      FROM  DWKR_02.V_BASIS_ACTIVITY v
            LEFT OUTER JOIN
            DWKR_02.REPORT_PARAM_BASIS_ACTIVITY p
            ON v.BASIS_ACTIVITY_ID = p.BASIS_ACTIVITY_ID
               AND p.REPORT_ID = L_REPORT_ID
      WHERE (EXISTS(SELECT * FROM DWKR_02.REPORT_PARAM_BASIS_ACTIVITY WHERE REPORT_ID = L_REPORT_ID)
             AND v.BASIS_ACTIVITY_ID = p.BASIS_ACTIVITY_ID
            )
            OR NOT EXISTS(SELECT * FROM DWKR_02.REPORT_PARAM_BASIS_ACTIVITY WHERE REPORT_ID = L_REPORT_ID)
      ORDER BY REPORT_ID, BASIS_ACTIVITY_ID
    ),
    prm_borr AS
    (
      SELECT L_REPORT_ID AS REPORT_ID, br.BORR_ID
      FROM  DWKR_02.BORR br
            LEFT OUTER JOIN
            DWKR_02.REPORT_PARAM_BORR_TYPE p_br_tp
            ON br.CLIENT_CODE = p_br_tp.BORR_TYPE_ID
               AND p_br_tp.REPORT_ID = L_REPORT_ID
      WHERE (
              (EXISTS(SELECT * FROM DWKR_02.REPORT_PARAM_BORR_TYPE WHERE REPORT_ID = L_REPORT_ID)
               AND br.CLIENT_CODE = p_br_tp.BORR_TYPE_ID AND p_br_tp.REPORT_ID = L_REPORT_ID
              )
              OR
              NOT EXISTS(SELECT * FROM DWKR_02.REPORT_PARAM_BORR_TYPE WHERE REPORT_ID = L_REPORT_ID)
            )
      ORDER BY REPORT_ID, BORR_ID
  ),
    prm_bank AS
    (
      SELECT DISTINCT L_REPORT_ID AS REPORT_ID, bn.BANK_ID
      FROM  DWKR_02.V_BANK bn
            LEFT OUTER JOIN
            DWKR_02.REPORT_PARAM_BANK p_bn
            ON bn.BANK_ID = p_bn.BANK_ID
               AND p_bn.REPORT_ID = L_REPORT_ID
            LEFT OUTER JOIN
            DWKR_02.V_BANK_CRED_HIST_SOURCE_GROUP_DATE_RANGE_LATEST bank_cr_hist_sg
            ON bn.BANK_ID = bank_cr_hist_sg.BANK_ID
            LEFT OUTER JOIN
            DWKR_02.REPORT_PARAM_CRED_HIST_SOURCE_GROUP p_cr_hist_sg
            ON p_cr_hist_sg.CRED_HIST_SOURCE_GROUP_ID = bank_cr_hist_sg.CRED_HIST_SOURCE_GROUP_ID
               AND p_cr_hist_sg.REPORT_ID = L_REPORT_ID
      WHERE (
              EXISTS(SELECT * FROM DWKR_02.REPORT_PARAM_CRED_HIST_SOURCE_GROUP WHERE REPORT_ID = L_REPORT_ID)
              AND
              (     bn.BANK_ID = bank_cr_hist_sg.BANK_ID
                AND bank_cr_hist_sg.CRED_HIST_SOURCE_GROUP_ID = p_cr_hist_sg.CRED_HIST_SOURCE_GROUP_ID
                AND p_cr_hist_sg.REPORT_ID = L_REPORT_ID
              )
            )
            OR 
            (
              NOT EXISTS(SELECT * FROM DWKR_02.REPORT_PARAM_CRED_HIST_SOURCE_GROUP WHERE REPORT_ID = L_REPORT_ID)
            )
      ORDER BY REPORT_ID, BANK_ID
    ),
    prm_crncy AS
    (
      SELECT REPORT_ID, CURRENCY_ID
      FROM DWKR_02.REPORT_PARAM_CURRENCY
      WHERE REPORT_ID = L_REPORT_ID
      
      UNION
  
      SELECT L_REPORT_ID AS REPORT_ID, v.VALUTA_ID AS CURRENCY_ID
      FROM DWKR_02.V_VALUTA v
           LEFT OUTER JOIN
           DWKR_02.REPORT_PARAM_CURRENCY_TYPE pct
           ON ( pct.REPORT_ID = L_REPORT_ID
                AND
                (
                  (v.VALUTA_ID = 933 AND pct.CURRENCY_TYPE_ID IN (0,1))
                  OR
                  (v.VALUTA_ID <> 933 AND pct.CURRENCY_TYPE_ID IN (0,2))
                )
              )
      WHERE ( (EXISTS (SELECT * FROM DWKR_02.REPORT_PARAM_CURRENCY_TYPE WHERE REPORT_ID = L_REPORT_ID) 
                AND
                (
                  (v.VALUTA_ID = 933 AND pct.CURRENCY_TYPE_ID IN (0,1))
                  OR
                  (v.VALUTA_ID <> 933 AND pct.CURRENCY_TYPE_ID IN (0,2))
                )
              )
              OR 
              NOT EXISTS (SELECT * FROM DWKR_02.REPORT_PARAM_CURRENCY_TYPE WHERE REPORT_ID = L_REPORT_ID)
            )
            AND NOT EXISTS (SELECT * FROM DWKR_02.REPORT_PARAM_CURRENCY WHERE REPORT_ID = L_REPORT_ID)
      ORDER BY REPORT_ID, CURRENCY_ID
    ),
    kd_end AS
    (
      SELECT
            ur.BASIS_ACTIVITY_ID,
            kd.BORR_ID,
            kd.KRED_DOG_ID,
            kd.BANK_ID,
            kd.KRED_TYPE_ID,
            kd.KRED_TYPE_VID_ID,
            kd.KRED_DOG_DATE,
            kd.KRED_DOG_END_DATE,
            kd.TOTAL_END_DATE
      FROM   prm_dt_range,
             DWKR_02.KD_5Y kd
             INNER JOIN
             DWKR_02.BORR_UR ur
             ON kd.BORR_ID = ur.BORR_ID
             INNER JOIN
             DWKR_02.V_BANK bn
             ON kd.BANK_ID = bn.BANK_ID
             INNER JOIN
             prm_base_act
             ON ur.BASIS_ACTIVITY_ID = prm_base_act.BASIS_ACTIVITY_ID
  
             LEFT OUTER JOIN
             prm_kt
             ON kd.KRED_TYPE_ID = prm_kt.KRED_TYPE_ID
        WHERE kd.KRED_TYPE_ID IN (1,2,3,7,8,9,10)
          AND (    EXISTS (SELECT * FROM prm_kt) AND kd.KRED_TYPE_ID = prm_kt.KRED_TYPE_ID
               OR
               NOT EXISTS (SELECT * FROM prm_kt) )
  
          AND kd.KRED_DOG_DATE <= prm_dt_range.DATE_END
          AND ( kd.TOTAL_END_DATE IS NULL OR
                kd.TOTAL_END_DATE >= prm_dt_range.DATE_END
              )
    ),
    kd_end_crncy AS
    (
       SELECT DISTINCT
            BORR_ID,
            KRED_DOG_ID,
            VALUTA_ID
       FROM
       (
          SELECT DISTINCT
              kd_end.BORR_ID,
              kd_end.KRED_DOG_ID,
              kdis.VALUTA_ID
          FROM  prm_dt_range,
                kd_end
                INNER JOIN
                DWKR_02.KD_ISP_SUM_AE_5Y kdis
                ON kd_end.BORR_ID = kdis.BORR_ID AND kd_end.KRED_DOG_ID = kdis.KRED_DOG_ID
          WHERE kdis.BEGIN_DATE <= prm_dt_range.DATE_END
            AND (kdis.END_DATE IS NULL OR kdis.END_DATE >= prm_dt_range.DATE_END)
  
          UNION
  
          SELECT DISTINCT
              kd_end.BORR_ID,
              kd_end.KRED_DOG_ID,
              lt1.VALUTA_ID
          FROM  prm_dt_range,
                kd_end
                INNER JOIN
                DWKR_02.KD_ISP_LATE_REST1_AE_5Y lt1
                ON kd_end.BORR_ID = lt1.BORR_ID AND kd_end.KRED_DOG_ID = lt1.KRED_DOG_ID
          WHERE lt1.BEGIN_DATE <= prm_dt_range.DATE_END
            AND (lt1.END_DATE IS NULL OR lt1.END_DATE >= prm_dt_range.DATE_END)
  
          UNION
  
          SELECT DISTINCT
              kd_end.BORR_ID,
              kd_end.KRED_DOG_ID,
              lt6.VALUTA_ID
          FROM  prm_dt_range,
                kd_end
                INNER JOIN
                DWKR_02.KD_ISP_LATE_REST6_AE_5Y lt6
                ON kd_end.BORR_ID = lt6.BORR_ID AND kd_end.KRED_DOG_ID = lt6.KRED_DOG_ID
          WHERE lt6.BEGIN_DATE <= prm_dt_range.DATE_END
            AND (lt6.END_DATE IS NULL OR lt6.END_DATE >= prm_dt_range.DATE_END)
  
          UNION
  
          SELECT DISTINCT
              kd_end.BORR_ID,
              kd_end.KRED_DOG_ID,
              lt7.VALUTA_ID
          FROM  prm_dt_range,
                kd_end
                INNER JOIN
                DWKR_02.KD_ISP_LATE_REST7_AE_5Y lt7
                ON kd_end.BORR_ID = lt7.BORR_ID AND kd_end.KRED_DOG_ID = lt7.KRED_DOG_ID
          WHERE lt7.BEGIN_DATE <= prm_dt_range.DATE_END
            AND (lt7.END_DATE IS NULL OR lt7.END_DATE >= prm_dt_range.DATE_END)
  
          UNION
  
          SELECT DISTINCT
              kd_end.BORR_ID,
              kd_end.KRED_DOG_ID,
              lt10.VALUTA_ID
          FROM  prm_dt_range,
                kd_end
                INNER JOIN
                DWKR_02.KD_ISP_LATE_REST10_AE_5Y lt10
                ON kd_end.BORR_ID = lt10.BORR_ID AND kd_end.KRED_DOG_ID = lt10.KRED_DOG_ID
          WHERE lt10.BEGIN_DATE <= prm_dt_range.DATE_END
            AND (lt10.END_DATE IS NULL OR lt10.END_DATE >= prm_dt_range.DATE_END)
  
          UNION
  
          SELECT DISTINCT
              kd_end.BORR_ID,
              kd_end.KRED_DOG_ID,
              lt11.VALUTA_ID
          FROM  prm_dt_range,
                kd_end
                INNER JOIN
                DWKR_02.KD_ISP_LATE_REST11_AE_5Y lt11
                ON kd_end.BORR_ID = lt11.BORR_ID AND kd_end.KRED_DOG_ID = lt11.KRED_DOG_ID
          WHERE lt11.BEGIN_DATE <= prm_dt_range.DATE_END
            AND (lt11.END_DATE IS NULL OR lt11.END_DATE >= prm_dt_range.DATE_END)
       ) t
       INNER JOIN
       prm_crncy
       ON prm_crncy.CURRENCY_ID = t.VALUTA_ID
    ),
    kd_begin AS
    (
      SELECT
            ur.BASIS_ACTIVITY_ID,
            kd.BORR_ID,
            kd.KRED_DOG_ID,
            kd.BANK_ID,
            kd.KRED_TYPE_ID,
            kd.KRED_TYPE_VID_ID,
            kd.KRED_DOG_DATE,
            kd.KRED_DOG_END_DATE,
            kd.TOTAL_END_DATE
