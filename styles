import re
from datetime import datetime


def generate_message_id(
    original_id: str,
    message_type: str,
    counter: int,
    timestamp: datetime | None = None
) -> str:
    """
    Генерация ID по алгоритму старого bips.exe:

    первые 7 символов исходного ID
    + YYYYMMDDHHMMSS
    + тип ID (MP8 / IP8 / TP8)
    + счетчик из 7 цифр
    """

    if timestamp is None:
        timestamp = datetime.now()

    prefix = original_id[:7]
    timestamp_part = timestamp.strftime("%Y%m%d%H%M%S")
    counter_part = f"{counter:07d}"

    return f"{prefix}{timestamp_part}{message_type}{counter_part}"


def get_tag_value(xml_text: str, tag_name: str) -> str:
    """
    Получает значение первого XML-тега.
    Поддерживает namespace:
        <MsgId>
        <ns:MsgId>
    """

    pattern = (
        rf"<(?:\w+:)?{tag_name}>"
        rf"\s*([^<]+?)\s*"
        rf"</(?:\w+:)?{tag_name}>"
    )

    match = re.search(pattern, xml_text)

    if not match:
        raise ValueError(f"Тег <{tag_name}> не найден")

    return match.group(1).strip()


def replace_tag_value(
    xml_text: str,
    tag_name: str,
    new_value: str
) -> str:
    """
    Заменяет содержимое всех тегов с указанным именем
    на одно значение.
    """

    pattern = (
        rf"(<(?:\w+:)?{tag_name}>)"
        rf"[^<]*"
        rf"(</(?:\w+:)?{tag_name}>)"
    )

    return re.sub(
        pattern,
        lambda match: (
            match.group(1)
            + new_value
            + match.group(2)
        ),
        xml_text
    )


def replace_tx_ids(
    xml_text: str,
    timestamp: datetime
) -> tuple[str, list[str]]:
    """
    Обрабатывает ВСЕ TxId в документе.

    Для каждого вхождения используется свой счетчик:

        первое  TxId -> 0000000
        второе  TxId -> 0000001
        третье  TxId -> 0000002
        ...

    При этом первые 7 символов берутся из исходного
    значения соответствующего TxId.
    """

    counter = 0
    generated_ids = []

    pattern = re.compile(
        rf"(<(?:\w+:)?TxId>)"
        rf"([^<]*)"
        rf"(</(?:\w+:)?TxId>)"
    )

    def replace(match):
        nonlocal counter

        original_id = match.group(2).strip()

        new_id = generate_message_id(
            original_id=original_id,
            message_type="TP8",
            counter=counter,
            timestamp=timestamp
        )

        generated_ids.append(new_id)

        counter += 1

        return (
            match.group(1)
            + new_id
            + match.group(3)
        )

    xml_text = pattern.sub(
        replace,
        xml_text
    )

    return xml_text, generated_ids


def prepare_dates(
    xml_text: str,
    now: datetime
) -> str:
    """
    Меняет даты/время на текущие.

    Дата:
        CreDt
        IntrBkSttlmDt
        RltdDt

    Дата + время:
        CreDtTm
        AccptncDtTm
    """

    current_date = now.strftime("%Y-%m-%d")

    current_datetime = now.strftime(
        "%Y-%m-%dT%H:%M:%S+03:00"
    )

    # Даты
    for tag_name in (
        "CreDt",
        "IntrBkSttlmDt",
        "RltdDt",
    ):
        pattern = (
            rf"<(?:\w+:)?{tag_name}>"
            rf"\s*[^<]*"
            rf"</(?:\w+:)?{tag_name}>"
        )

        if re.search(pattern, xml_text):
            xml_text = replace_tag_value(
                xml_text,
                tag_name,
                current_date
            )

    # Дата + время
    for tag_name in (
        "CreDtTm",
        "AccptncDtTm",
    ):
        pattern = (
            rf"<(?:\w+:)?{tag_name}>"
            rf"\s*[^<]*"
            rf"</(?:\w+:)?{tag_name}>"
        )

        if re.search(pattern, xml_text):
            xml_text = replace_tag_value(
                xml_text,
                tag_name,
                current_datetime
            )

    return xml_text


def prepare_pacs008(
    xml_text: str,
    counter: int = 0,
    timestamp: datetime | None = None
):
    """
    Подготавливает один pacs.008.

    Делает:

    1. MsgId
    2. InstrId
    3. Все TxId
    4. Даты/время
    """

    if timestamp is None:
        timestamp = datetime.now()

    # ---------------------------------------------------------
    # MsgId
    # ---------------------------------------------------------

    original_msg_id = get_tag_value(
        xml_text,
        "MsgId"
    )

    msg_id = generate_message_id(
        original_msg_id,
        "MP8",
        counter,
        timestamp
    )

    xml_text = replace_tag_value(
        xml_text,
        "MsgId",
        msg_id
    )

    # ---------------------------------------------------------
    # InstrId
    # ---------------------------------------------------------

    original_instr_id = get_tag_value(
        xml_text,
        "InstrId"
    )

    instr_id = generate_message_id(
        original_instr_id,
        "IP8",
        counter,
        timestamp
    )

    xml_text = replace_tag_value(
        xml_text,
        "InstrId",
        instr_id
    )

    # ---------------------------------------------------------
    # Все TxId
    # ---------------------------------------------------------

    xml_text, tx_ids = replace_tx_ids(
        xml_text,
        timestamp
    )

    # ---------------------------------------------------------
    # Даты
    # ---------------------------------------------------------

    xml_text = prepare_dates(
        xml_text,
        timestamp
    )

    # ---------------------------------------------------------
    # Результат
    # ---------------------------------------------------------

    ids = {
        "MsgId": msg_id,
        "InstrId": instr_id,
        "TxId": tx_ids,
    }

    return xml_text, ids


def prepare_pacs008_messages(
    xml_text: str,
    number_of_messages: int
):
    """
    Генерирует несколько pacs.008.

    Для каждого нового сообщения общий counter
    увеличивается:

        сообщение 1 -> 0000000
        сообщение 2 -> 0000001
        сообщение 3 -> 0000002

    Но TxId внутри каждого отдельного XML
    считает свои вхождения с нуля.
    """

    messages = []

    for counter in range(number_of_messages):

        prepared_xml, ids = prepare_pacs008(
            xml_text,
            counter=counter
        )

        messages.append(
            (prepared_xml, ids)
        )

    return messages







