import subprocess
import uuid
import os
import json


TESTS_MAP = {

    "kr_legal":
        "tests/credit_register/test_legal_users.py",

    "kr_reports":
        "tests/credit_register/test_reports.py",

    "smp_login":
        "tests/smp/test_login.py",
}


def run_pytest(test_names):

    run_id = str(uuid.uuid4())

    report_file = f"reports/{run_id}.json"

    os.makedirs("reports", exist_ok=True)

    selected_paths = []

    for test_name in test_names:

        if test_name in TESTS_MAP:
            selected_paths.append(
                TESTS_MAP[test_name]
            )

    if not selected_paths:
        return {
            "error": "No valid tests selected"
        }

    command = [
        "pytest",
        *selected_paths,
        "-v",
        "--json-report",
        f"--json-report-file={report_file}"
    ]

    result = subprocess.run(
        command,
        capture_output=True,
        text=True
    )

    report_data = {}

    if os.path.exists(report_file):

        with open(report_file, "r", encoding="utf-8") as f:
            report_data = json.load(f)

    text_report = build_text_report(report_data)

    return {
        "run_id": run_id,
        "stdout": result.stdout,
        "stderr": result.stderr,
        "report": report_data,
        "text_report": text_report
    }


def build_text_report(report_data):

    summary = report_data.get("summary", {})

    tests = report_data.get("tests", [])

    lines = []

    lines.append("TEST RESULTS\n")

    lines.append(f"Passed: {summary.get('passed', 0)}")
    lines.append(f"Failed: {summary.get('failed', 0)}")
    lines.append(f"Skipped: {summary.get('skipped', 0)}")

    lines.append("\nDETAILS:")

    for test in tests:

        nodeid = test.get("nodeid", "unknown")

        outcome = test.get("outcome", "unknown")

        lines.append(
            f"- {nodeid} - {outcome.upper()}"
        )

    return "\n".join(lines)