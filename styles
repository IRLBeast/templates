def get_latest_confirmation_code(api_url="http://10.2.9.125:8001/TestApi/GetSentMessagesInfo"):
    try:
        response = requests.post(api_url, timeout=10)
        response.raise_for_status()

        messages = response.json()

        if not messages:
            raise ValueError("РќРµС‚ СЃРѕРѕР±С‰РµРЅРёР№ РІ РѕС‚РІРµС‚Рµ API")

        last_message = messages[-1]

        message_text = last_message["message"]

        code_match = re.search(r'(\d{4})', message_text)

        if code_match:
            confirmation_code = code_match.group(1)
            print(f"РќР°Р№РґРµРЅ РєРѕРґ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ: {confirmation_code}")
            return confirmation_code
        else:
            print(f"РљРѕРґ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ РЅРµ РЅР°Р№РґРµРЅ РІ СЃРѕРѕР±С‰РµРЅРёРё: {message_text}")
            return None

    except requests.exceptions.RequestException as e:
        print(f"РћС€РёР±РєР° РїСЂРё Р·Р°РїСЂРѕСЃРµ Рє API: {e}")
        return None
    except json.JSONDecodeError as e:
        print(f"РћС€РёР±РєР° РїР°СЂСЃРёРЅРіР° JSON: {e}")
        return None
    except Exception as e:
        print(f"РќРµРѕР¶РёРґР°РЅРЅР°СЏ РѕС€РёР±РєР°: {e}")
        return None

