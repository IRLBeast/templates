def get_optional_tag_value(
    xml_text: str,
    tag_name: str
) -> str | None:
    pattern = (
        rf"<(?:\w+:)?{tag_name}>"
        rf"\s*([^<]*?)\s*"
        rf"</(?:\w+:)?{tag_name}>"
    )

    match = re.search(pattern, xml_text)

    if not match:
        return None

    return match.group(1).strip()





def prepare_pacs008(
    xml_text: str,
    counter: int = 0,
    timestamp: datetime | None = None
):
    """
    Подготавливает XML.

    Отсутствующие ID-теги пропускаются.
    Все найденные TxId обрабатываются отдельно.
    Присутствующие даты обновляются.
    """

    if timestamp is None:
        timestamp = datetime.now()

    ids = {
        "MsgId": None,
        "InstrId": None,
        "TxId": [],
    }

    # ---------------------------------------------------------
    # MsgId — обрабатываем, только если тег существует
    # ---------------------------------------------------------

    original_msg_id = get_optional_tag_value(
        xml_text,
        "MsgId"
    )

    if original_msg_id is not None:
        ids["MsgId"] = generate_message_id(
            original_msg_id,
            "MP8",
            counter,
            timestamp
        )

        xml_text = replace_tag_value(
            xml_text,
            "MsgId",
            ids["MsgId"]
        )

    # ---------------------------------------------------------
    # InstrId — обрабатываем, только если тег существует
    # ---------------------------------------------------------

    original_instr_id = get_optional_tag_value(
        xml_text,
        "InstrId"
    )

    if original_instr_id is not None:
        ids["InstrId"] = generate_message_id(
            original_instr_id,
            "IP8",
            counter,
            timestamp
        )

        xml_text = replace_tag_value(
            xml_text,
            "InstrId",
            ids["InstrId"]
        )

    # ---------------------------------------------------------
    # TxId — обрабатываем все вхождения, если они есть
    # ---------------------------------------------------------

    xml_text, tx_ids = replace_tx_ids(
        xml_text,
        timestamp
    )

    ids["TxId"] = tx_ids

    # ---------------------------------------------------------
    # Даты — обновляются только при наличии тегов
    # ---------------------------------------------------------

    xml_text = prepare_dates(
        xml_text,
        timestamp
    )

    return xml_text, ids