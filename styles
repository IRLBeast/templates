import re
from datetime import datetime


def generate_message_id(
    original_id: str,
    message_type: str,
    counter: int,
    timestamp: datetime | None = None
) -> str:
    """
    Генерация ID по алгоритму старого bips.exe:

    первые 7 символов исходного ID
    + YYYYMMDDHHMMSS
    + тип ID (MP8 / IP8 / TP8)
    + счетчик из 7 цифр
    """

    if timestamp is None:
        timestamp = datetime.now()

    prefix = original_id[:7]
    timestamp_part = timestamp.strftime("%Y%m%d%H%M%S")
    counter_part = f"{counter:07d}"

    return f"{prefix}{timestamp_part}{message_type}{counter_part}"


def get_tag_value(xml_text: str, tag_name: str) -> str:
    """
    Получает значение первого XML-тега.
    Поддерживает namespace, например:
    <MsgId>
    <ns:MsgId>
    """

    pattern = (
        rf"<(?:\w+:)?{tag_name}>"
        rf"\s*([^<]+?)\s*"
        rf"</(?:\w+:)?{tag_name}>"
    )

    match = re.search(pattern, xml_text)

    if not match:
        raise ValueError(f"Тег <{tag_name}> не найден")

    return match.group(1).strip()


def replace_tag_value(
    xml_text: str,
    tag_name: str,
    new_value: str
) -> str:
    """
    Заменяет содержимое всех тегов с указанным именем.
    """

    pattern = (
        rf"(<(?:\w+:)?{tag_name}>)"
        rf"[^<]*"
        rf"(</(?:\w+:)?{tag_name}>)"
    )

    return re.sub(
        pattern,
        lambda match: (
            match.group(1)
            + new_value
            + match.group(2)
        ),
        xml_text
    )


def prepare_dates(xml_text: str, now: datetime) -> str:
    """
    Меняет даты/время на текущие.

    CreDt              -> YYYY-MM-DD
    CreDtTm            -> YYYY-MM-DDTHH:MM:SS+03:00
    IntrBkSttlmDt      -> YYYY-MM-DD
    AccptncDtTm        -> YYYY-MM-DDTHH:MM:SS+03:00
    RltdDt             -> YYYY-MM-DD
    """

    current_date = now.strftime("%Y-%m-%d")
    current_datetime = now.strftime("%Y-%m-%dT%H:%M:%S+03:00")

    # Дата
    for tag_name in (
        "CreDt",
        "IntrBkSttlmDt",
        "RltdDt",
    ):
        # Меняем только если тег действительно есть
        pattern = (
            rf"<(?:\w+:)?{tag_name}>"
            rf"\s*[^<]*"
            rf"</(?:\w+:)?{tag_name}>"
        )

        if re.search(pattern, xml_text):
            xml_text = replace_tag_value(
                xml_text,
                tag_name,
                current_date
            )

    # Дата + время
    for tag_name in (
        "CreDtTm",
        "AccptncDtTm",
    ):
        pattern = (
            rf"<(?:\w+:)?{tag_name}>"
            rf"\s*[^<]*"
            rf"</(?:\w+:)?{tag_name}>"
        )

        if re.search(pattern, xml_text):
            xml_text = replace_tag_value(
                xml_text,
                tag_name,
                current_datetime
            )

    return xml_text


def prepare_pacs008(
    xml_text: str,
    counter: int = 0,
    timestamp: datetime | None = None
):
    """
    Подготавливает один pacs.008.

    Делает:
    1. Генерацию MsgId
    2. Генерацию InstrId
    3. Генерацию TxId
    4. Обновление дат/времени
    """

    if timestamp is None:
        timestamp = datetime.now()

    # ---------------------------------------------------------
    # 1. MsgId
    # ---------------------------------------------------------

    original_msg_id = get_tag_value(
        xml_text,
        "MsgId"
    )

    msg_id = generate_message_id(
        original_msg_id,
        "MP8",
        counter,
        timestamp
    )

    xml_text = replace_tag_value(
        xml_text,
        "MsgId",
        msg_id
    )

    # ---------------------------------------------------------
    # 2. InstrId
    # ---------------------------------------------------------

    original_instr_id = get_tag_value(
        xml_text,
        "InstrId"
    )

    instr_id = generate_message_id(
        original_instr_id,
        "IP8",
        counter,
        timestamp
    )

    xml_text = replace_tag_value(
        xml_text,
        "InstrId",
        instr_id
    )

    # ---------------------------------------------------------
    # 3. TxId
    # ---------------------------------------------------------

    tx_id = None

    try:
        original_tx_id = get_tag_value(
            xml_text,
            "TxId"
        )

        tx_id = generate_message_id(
            original_tx_id,
            "TP8",
            counter,
            timestamp
        )

        xml_text = replace_tag_value(
            xml_text,
            "TxId",
            tx_id
        )

    except ValueError:
        # В старом коде TxId был необязательным
        pass

    # ---------------------------------------------------------
    # 4. Даты
    # ---------------------------------------------------------

    xml_text = prepare_dates(
        xml_text,
        timestamp
    )

    # ---------------------------------------------------------
    # Результат
    # ---------------------------------------------------------

    ids = {
        "MsgId": msg_id,
        "InstrId": instr_id,
        "TxId": tx_id,
    }

    return xml_text, ids


def prepare_pacs008_messages(
    xml_text: str,
    number_of_messages: int
):
    """
    Генерирует несколько pacs.008.

    Аналог старого:
        num = 0
        ...
        num++

    Для каждого сообщения увеличивается counter.
    """

    messages = []

    for counter in range(number_of_messages):
        prepared_xml, ids = prepare_pacs008(
            xml_text,
            counter=counter
        )

        messages.append(
            (prepared_xml, ids)
        )

    return messages
