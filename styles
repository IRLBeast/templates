<q-table
    title="РЎРѕРѕР±С‰РµРЅРёСЏ DB2B"
    :data="data"
    :columns="columns"
    row-key="IdMessageInMX"
    :filter="search"
    @row-contextmenu="onRowContextMenu">


methods: {

    onRowContextMenu(evt, row) {
    evt.preventDefault();
    this.selectedRow = row;
    this.$refs.rowMenu.show(evt);
    },

    showMessage() {
    fetch(`/api/message/${this.selectedRow.IdMessageInMX}`)
        .then(r => r.json())
        .then(data => {
            this.messageText = data.message;
            this.messageDialog = true;
        });
    },


    loadData() {
    this.loading = true;

    fetch("/api/messages")
        .then(response => response.json())
        .then(data => {
            this.data = data;
        })
        .finally(() => {
            this.loading = false;
        });
    }
}