<ul class="ks-cboxtags">

    <li>
        <input type="checkbox" id="kr_legal" value="kr_legal">
        <label for="kr_legal">Credit Register - Legal Users</label>
    </li>

    <li>
        <input type="checkbox" id="kr_reports" value="kr_reports">
        <label for="kr_reports">Credit Register - Reports</label>
    </li>

    <li>
        <input type="checkbox" id="smp_login" value="smp_login">
        <label for="smp_login">SMP Login</label>
    </li>

</ul>

<button onclick="runSelectedTests()">
    Run tests
</button>

<pre id="output"></pre>


<script>

function runSelectedTests() {

    const selected = [];

    document.querySelectorAll(
        ".ks-cboxtags input:checked"
    ).forEach(cb => {
        selected.push(cb.value);
    });

    if (selected.length === 0) {
        alert("Select at least one test");
        return;
    }

    document.getElementById("output").textContent =
        "Running tests...";

    fetch("/run-tests/", {

        method: "POST",

        headers: {
            "Content-Type": "application/json",
        },

        body: JSON.stringify({
            tests: selected
        })

    })

    .then(res => res.json())

    .then(data => {

        let output = "";

        if (data.text_report) {
            output += data.text_report;
        }

        if (data.stderr) {
            output += "\n\nERRORS:\n" + data.stderr;
        }

        document.getElementById("output").textContent = output;
    });
}

</script>


