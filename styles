import json

from django.http import JsonResponse
from django.views.decorators.csrf import csrf_exempt

from .services.runner import run_pytest


@csrf_exempt
def run_tests(request):

    data = json.loads(request.body)

    selected_tests = data.get("tests", [])

    result = run_pytest(selected_tests)

    return JsonResponse(result)


runner.py
import subprocess


TESTS_MAP = {

    "kr_legal":
        "tests/credit_register/test_legal_users.py",

    "kr_reports":
        "tests/credit_register/test_reports.py",

    "smp_login":
        "tests/smp/test_login.py",
}


def run_pytest(test_names):

    selected_paths = []

    for test_name in test_names:

        if test_name in TESTS_MAP:
            selected_paths.append(
                TESTS_MAP[test_name]
            )

    command = [
        "pytest",
        *selected_paths,
        "-v"
    ]

    result = subprocess.run(
        command,
        capture_output=True,
        text=True
    )

    return {
        "stdout": result.stdout,
        "stderr": result.stderr,
        "text_report": result.stdout
    }