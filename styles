3. Полностью runSelectedTests()
Я бы сейчас сделал функцию вот такой:
function runSelectedTests() {

    const selected = [];
    const browsers = [];

    // Получаем выбранные тесты
    document.querySelectorAll(
        ".ks-cboxtags input:checked"
    ).forEach(cb => {
        selected.push(cb.value);
    });

    // Получаем выбранные браузеры
    document.querySelectorAll(
        ".browser-tags input:checked"
    ).forEach(cb => {
        browsers.push(cb.value);
    });

    if (selected.length === 0) {
        alert("Select at least one test");
        return;
    }

    if (browsers.length === 0) {
        alert("Select at least one browser");
        return;
    }

    document.getElementById("output").textContent =
        "Running tests...";

    fetch("/run-tests/", {

        method: "POST",

        headers: {
            "Content-Type": "application/json",
        },

        body: JSON.stringify({
            tests: selected,
            browsers: browsers
        })

    })

    .then(res => res.json())

    .then(data => {

        let output = "";

        if (data.text_report) {
            output += data.text_report;
        }

        if (data.stderr) {
            output += "\n\nERRORS:\n" + data.stderr;
        }

        document.getElementById("output").textContent = output;
    })

    .catch(err => {

        document.getElementById("output").textContent =
            "Error: " + err;

    });
}
Теперь браузеры реально отправляются Django.
