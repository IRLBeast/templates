def get_latest_confirmation_code(api_url="http://10.2.9.125:8001/TestApi/GetSentMessagesInfo"):
    try:
        response = requests.post(api_url, timeout=10)
        response.raise_for_status()
        
        messages = response.json()
        
        if not messages:
            raise ValueError("no messages")
        
        last_message = messages[-1]
        
        message_text = last_message["message"]
        
        import re
        code_match = re.search(r'(\d{4})', message_text)
        
        if code_match:
            confirmation_code = code_match.group(1)
            return confirmation_code
        else:
            return None
            
    except requests.exceptions.RequestException as e:
        print(f"err to Рє API: {e}")
        return None
    except json.JSONDecodeError as e:
        print(f"JSON err: {e}")
        return None
    except Exception as e:
        print(f"other err: {e}")
        return None

def handle_session_modal_advanced(driver):

    max_wait = 3
    
    try:
        WebDriverWait(driver, max_wait).until(
            EC.text_to_be_present_in_element((By.TAG_NAME, "body"), 
                                           "already in system")
        )
        
        
        annul_button = driver.find_element(By.ID, "form-popup-confirm")
        annul_button.click()
        print("pressed button 'annul'")
        
        return True
        
    except TimeoutException:
        print(f"no window appeared in {max_wait} sec")
        return False
    except Exception as e:
        print(f"other err: {e}")
        return False