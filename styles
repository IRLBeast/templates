def generate_message_id(
    original_id: str,
    message_type: str,
    counter: int,
    timestamp: datetime | None = None
) -> str:
    """
    Генерация ID.

    Для MsgId / InstrId:

        prefix + YYYYMMDDHHMMSS + MP8/IP8 + 7 цифр

    Для TxId:

        prefix + YYYYMMDDHHMMSS + TP8 + номер + 6 цифр
    """

    if timestamp is None:
        timestamp = datetime.now()

    prefix = original_id[:7]
    timestamp_part = timestamp.strftime("%Y%m%d%H%M%S")

    if message_type == "TP8":
        # Например:
        # TP80000000
        # TP81000000
        # TP82000000
        counter_part = f"{counter}000000"
    else:
        # Например:
        # MP80000000
        # IP80000000
        # MP80000001
        counter_part = f"{counter:07d}"

    return (
        f"{prefix}"
        f"{timestamp_part}"
        f"{message_type}"
        f"{counter_part}"
    )




def replace_tx_ids(
    xml_text: str,
    timestamp: datetime
) -> tuple[str, list[str]]:
    """
    Обрабатывает все TxId.

    Первое вхождение:
        TP80000000

    Второе:
        TP81000000

    Третье:
        TP82000000
    """

    counter = 0
    generated_ids = []

    pattern = re.compile(
        rf"(<(?:\w+:)?TxId>)"
        rf"([^<]*)"
        rf"(</(?:\w+:)?TxId>)"
    )

    def replace(match):
        nonlocal counter

        original_id = match.group(2).strip()

        new_id = generate_message_id(
            original_id=original_id,
            message_type="TP8",
            counter=counter,
            timestamp=timestamp
        )

        generated_ids.append(new_id)

        counter += 1

        return (
            match.group(1)
            + new_id
            + match.group(3)
        )

    xml_text = pattern.sub(
        replace,
        xml_text
    )

    return xml_text, generated_ids