            AND (kdf.END_DATE IS NULL OR kdf.END_DATE >= prm_dt_range.DATE_END)
        
        ) kd_end_debt
        
        LEFT OUTER JOIN
        
        (
        
        SELECT
            kd_begin_flt_cr.BASIS_ACTIVITY_ID,
            kd_begin_flt_cr.BORR_ID,
            kd_begin_flt_cr.KRED_DOG_ID,
            kd_begin_flt_cr.BANK_ID,
            kd_begin_flt_cr.KRED_TYPE_ID,
            kd_begin_flt_cr.KRED_TYPE_VID_ID,
            kd_begin_flt_cr.KRED_DOG_DATE,
            kd_begin_flt_cr.KRED_DOG_END_DATE,
            kd_begin_flt_cr.TOTAL_END_DATE,
            kdf.END_DATE_OSN AS PERFORMANCE_DATE,
            kdis_byn.REMAINING_DEBT,
            -- kdisf_byn.REMAINING_DEBT_FCTR_UNDSCL_SUM,
            lt1_byn.OVRD_REST_1,
            lt6_byn.OVRD_REST_6,
            lt7_byn.OVRD_REST_7,
            -- lt8_byn.OVRD_REST_8,
            lt10_byn.OVRD_REST_10,
            lt11_byn.OVRD_REST_11,
            /*
            (COALESCE(kdis_byn.REMAINING_DEBT,0) +
            COALESCE(kdisf_byn.REMAINING_DEBT_FCTR_UNDSCL_SUM,0) +
            COALESCE(lt1_byn.OVRD_REST_1,0) +
            COALESCE(lt6_byn.OVRD_REST_6,0) +
            COALESCE(lt7_byn.OVRD_REST_7,0) +
            COALESCE(lt8_byn.OVRD_REST_8,0) +
            COALESCE(lt10_byn.OVRD_REST_10,0) +
            COALESCE(lt11_byn.OVRD_REST_11,0)) AS MAIN_DEBT_BYN
            */
            CASE
              WHEN kd_begin_flt_cr.KRED_TYPE_ID IN (1,2,3,10) THEN -- кредиты
                CASE
                  WHEN kdis_byn.REMAINING_DEBT IS NULL AND lt1_byn.OVRD_REST_1 IS NULL THEN NULL
                  ELSE COALESCE(kdis_byn.REMAINING_DEBT,0) + COALESCE(lt1_byn.OVRD_REST_1,0)
                END
              WHEN kd_begin_flt_cr.KRED_TYPE_ID IN (7) THEN -- лизинг
                CASE
                  WHEN kdis_byn.REMAINING_DEBT IS NULL AND lt6_byn.OVRD_REST_6 IS NULL THEN NULL
                  ELSE COALESCE(kdis_byn.REMAINING_DEBT,0) + COALESCE(lt6_byn.OVRD_REST_6,0)
                END
              WHEN kd_begin_flt_cr.KRED_TYPE_ID IN (8) THEN -- факторинг
                CASE
                  WHEN kdis_byn.REMAINING_DEBT IS NULL AND lt7_byn.OVRD_REST_7 IS NULL AND lt10_byn.OVRD_REST_10 IS NULL THEN NULL
                  ELSE COALESCE(kdis_byn.REMAINING_DEBT, 0)
                      + COALESCE(lt7_byn.OVRD_REST_7, 0) -- у кредитора
                      + COALESCE(lt10_byn.OVRD_REST_10, 0) -- у должника
                END
              WHEN kd_begin_flt_cr.KRED_TYPE_ID IN (9) THEN -- факторинговые операции
                CASE
                  WHEN kdis_byn.REMAINING_DEBT IS NULL AND lt11_byn.OVRD_REST_11 IS NULL THEN NULL
                  ELSE COALESCE(kdis_byn.REMAINING_DEBT,0) + COALESCE(lt11_byn.OVRD_REST_11,0)
                END
            END AS MAIN_DEBT_BYN
        FROM prm_dt_range,
             ( SELECT DISTINCT kd_begin.*
               FROM kd_begin
                    INNER JOIN
                    kd_begin_crncy
                    ON kd_begin.BORR_ID = kd_begin_crncy.BORR_ID AND kd_begin.KRED_DOG_ID = kd_begin_crncy.KRED_DOG_ID
             )
             kd_begin_flt_cr
             LEFT OUTER JOIN
             DWKR_02.KRED_DOG_FUTURE_AE kdf
             ON kd_begin_flt_cr.BORR_ID = kdf.BORR_ID AND kd_begin_flt_cr.KRED_DOG_ID = kdf.KRED_DOG_ID
        
              LEFT OUTER JOIN
        
              ( SELECT
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID,
                    SUM(
                        COALESCE(
                          CASE
                            WHEN COALESCE(kdis.VALUTA_ID,933)=933 OR COALESCE(kdis.OSTATOK_OSN,0)=0
                              THEN kdis.OSTATOK_OSN
                            ELSE ROUND(kdis.OSTATOK_OSN * course.RATE / course.SCALE, 3)
                          END
                        ,0)
                    ) AS REMAINING_DEBT
                FROM prm_dt_range,
                     kd_begin_crncy
                    INNER JOIN
                    DWKR_02.KD_ISP_SUM_AE_5Y kdis
                    ON kd_begin_crncy.BORR_ID = kdis.BORR_ID AND kd_begin_crncy.KRED_DOG_ID = kdis.KRED_DOG_ID AND kd_begin_crncy.VALUTA_ID = kdis.VALUTA_ID
                    LEFT OUTER JOIN
                    course
                    ON kdis.VALUTA_ID = course.VALUTA_ID
                WHERE kdis.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
                  AND (kdis.END_DATE IS NULL OR kdis.END_DATE >= prm_dt_range.DATE_BEGIN)
                GROUP BY
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID
              ) kdis_byn
              ON kd_begin_flt_cr.BORR_ID = kdis_byn.BORR_ID AND kd_begin_flt_cr.KRED_DOG_ID = kdis_byn.KRED_DOG_ID
        
              LEFT OUTER JOIN
        
              ( SELECT
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID,
                    SUM(
                        COALESCE(
                          CASE
                            WHEN COALESCE(lt1.VALUTA_ID,933)=933 OR COALESCE(lt1.REST,0)=0
                              THEN lt1.REST
                            ELSE ROUND(lt1.REST * course.RATE / course.SCALE, 3)
                          END
                        ,0)
                    ) AS OVRD_REST_1
                FROM prm_dt_range,
                     kd_begin_crncy
                    INNER JOIN
                    DWKR_02.KD_ISP_LATE_REST1_AE_5Y lt1
                    ON kd_begin_crncy.BORR_ID = lt1.BORR_ID AND kd_begin_crncy.KRED_DOG_ID = lt1.KRED_DOG_ID AND kd_begin_crncy.VALUTA_ID = lt1.VALUTA_ID
                    LEFT OUTER JOIN
                    course
                    ON lt1.VALUTA_ID = course.VALUTA_ID
                WHERE lt1.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
                  AND (lt1.END_DATE IS NULL OR lt1.END_DATE >= prm_dt_range.DATE_BEGIN)
                GROUP BY
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID
              ) lt1_byn
              ON kd_begin_flt_cr.BORR_ID = lt1_byn.BORR_ID AND kd_begin_flt_cr.KRED_DOG_ID = lt1_byn.KRED_DOG_ID
        
              LEFT OUTER JOIN
        
              ( SELECT
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID,
                    SUM(
                        COALESCE(
                          CASE
                            WHEN COALESCE(lt6.VALUTA_ID,933)=933 OR COALESCE(lt6.REST,0)=0
                              THEN lt6.REST
                            ELSE ROUND(lt6.REST * course.RATE / course.SCALE, 3)
                          END
                        ,0)
                    ) AS OVRD_REST_6
                FROM prm_dt_range,
                     kd_begin_crncy
                    INNER JOIN
                    DWKR_02.KD_ISP_LATE_REST6_AE_5Y lt6
                    ON kd_begin_crncy.BORR_ID = lt6.BORR_ID AND kd_begin_crncy.KRED_DOG_ID = lt6.KRED_DOG_ID AND kd_begin_crncy.VALUTA_ID = lt6.VALUTA_ID
                    LEFT OUTER JOIN
                    course
                    ON lt6.VALUTA_ID = course.VALUTA_ID
                WHERE lt6.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
                  AND (lt6.END_DATE IS NULL OR lt6.END_DATE >= prm_dt_range.DATE_BEGIN)
                GROUP BY
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID
              ) lt6_byn
              ON kd_begin_flt_cr.BORR_ID = lt6_byn.BORR_ID AND kd_begin_flt_cr.KRED_DOG_ID = lt6_byn.KRED_DOG_ID
        
              LEFT OUTER JOIN
        
              ( SELECT
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID,
                    SUM(
                        COALESCE(
                          CASE
                            WHEN COALESCE(lt7.VALUTA_ID,933)=933 OR COALESCE(lt7.REST,0)=0
                              THEN lt7.REST
                            ELSE ROUND(lt7.REST * course.RATE / course.SCALE, 3)
                          END
                        ,0)
                    ) AS OVRD_REST_7
                FROM prm_dt_range,
                     kd_begin_crncy
                    INNER JOIN
                    DWKR_02.KD_ISP_LATE_REST7_AE_5Y lt7
                    ON kd_begin_crncy.BORR_ID = lt7.BORR_ID AND kd_begin_crncy.KRED_DOG_ID = lt7.KRED_DOG_ID AND kd_begin_crncy.VALUTA_ID = lt7.VALUTA_ID
                    LEFT OUTER JOIN
                    course
                    ON lt7.VALUTA_ID = course.VALUTA_ID
                 WHERE lt7.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
                   AND (lt7.END_DATE IS NULL OR lt7.END_DATE >= prm_dt_range.DATE_BEGIN)
                GROUP BY
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID
              ) lt7_byn
              ON kd_begin_flt_cr.BORR_ID = lt7_byn.BORR_ID AND kd_begin_flt_cr.KRED_DOG_ID = lt7_byn.KRED_DOG_ID
        
              LEFT OUTER JOIN
        
              ( SELECT
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID,
                    SUM(
                        COALESCE(
                          CASE
                            WHEN COALESCE(lt10.VALUTA_ID,933)=933 OR COALESCE(lt10.REST,0)=0
                              THEN lt10.REST
                            ELSE ROUND(lt10.REST * course.RATE / course.SCALE, 3)
                          END
                        ,0)
                    ) AS OVRD_REST_10
                FROM prm_dt_range,
                     kd_begin_crncy
                    INNER JOIN
                    DWKR_02.KD_ISP_LATE_REST10_AE_5Y lt10
                    ON kd_begin_crncy.BORR_ID = lt10.BORR_ID AND kd_begin_crncy.KRED_DOG_ID = lt10.KRED_DOG_ID AND kd_begin_crncy.VALUTA_ID = lt10.VALUTA_ID
                    LEFT OUTER JOIN
                    course
                    ON lt10.VALUTA_ID = course.VALUTA_ID
                WHERE lt10.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
                  AND (lt10.END_DATE IS NULL OR lt10.END_DATE >= prm_dt_range.DATE_BEGIN)
                GROUP BY
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID
              ) lt10_byn
              ON kd_begin_flt_cr.BORR_ID = lt10_byn.BORR_ID AND kd_begin_flt_cr.KRED_DOG_ID = lt10_byn.KRED_DOG_ID
        
              LEFT OUTER JOIN
        
              ( SELECT
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID,
                    SUM(
                        COALESCE(
                          CASE
                            WHEN COALESCE(lt11.VALUTA_ID,933)=933 OR COALESCE(lt11.REST,0)=0
                              THEN lt11.REST
                            ELSE ROUND(lt11.REST * course.RATE / course.SCALE, 3)
                          END
                        ,0)
                    ) AS OVRD_REST_11
                FROM prm_dt_range,
                     kd_begin_crncy
                    INNER JOIN
                    DWKR_02.KD_ISP_LATE_REST11_AE_5Y lt11
                    ON kd_begin_crncy.BORR_ID = lt11.BORR_ID AND kd_begin_crncy.KRED_DOG_ID = lt11.KRED_DOG_ID AND kd_begin_crncy.VALUTA_ID = lt11.VALUTA_ID
                    LEFT OUTER JOIN
                    course
                    ON lt11.VALUTA_ID = course.VALUTA_ID
                WHERE lt11.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
                  AND (lt11.END_DATE IS NULL OR lt11.END_DATE >= prm_dt_range.DATE_BEGIN)
                GROUP BY
                    kd_begin_crncy.BORR_ID,
                    kd_begin_crncy.KRED_DOG_ID
              ) lt11_byn
              ON kd_begin_flt_cr.BORR_ID = lt11_byn.BORR_ID AND kd_begin_flt_cr.KRED_DOG_ID = lt11_byn.KRED_DOG_ID
        
          WHERE kdf.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
            AND (kdf.END_DATE IS NULL OR kdf.END_DATE >= prm_dt_range.DATE_BEGIN)
        
        ) kd_begin_debt
        ON kd_begin_debt.BORR_ID = kd_end_debt.BORR_ID AND kd_begin_debt.KRED_DOG_ID = kd_end_debt.KRED_DOG_ID
        WHERE COALESCE(kd_begin_debt.MAIN_DEBT_BYN,0) < COALESCE(kd_end_debt.MAIN_DEBT_BYN,0)
        ORDER BY kd_end_debt.BORR_ID, kd_end_debt.KRED_DOG_ID
        
        GROUP BY BASIS_ACTIVITY_ID, BANK_ID, KD_TERM_MONTHS_GROUP
      ORDER BY BASIS_ACTIVITY_ID, BANK_ID, KD_TERM_MONTHS_GROUP
    ) t2
    LEFT OUTER JOIN
    DWKR_02.V_BANK b
    ON t2.BANK_ID = b.BANK_ID
    LEFT OUTER JOIN
    DWKR_02.V_BASIS_ACTIVITY ba
    ON t2.BASIS_ACTIVITY_ID = ba.BASIS_ACTIVITY_ID
  GROUP BY GROUPING SETS ( (t2.BASIS_ACTIVITY_ID, ba.BASIS_ACTIVITY_CODE, ba.BASIS_ACTIVITY_NAME, t2.BANK_ID, b.SHORT_NAME),
                           (t2.BASIS_ACTIVITY_ID, ba.BASIS_ACTIVITY_CODE, ba.BASIS_ACTIVITY_NAME),
                           ()
                         )
  ORDER BY t2.BASIS_ACTIVITY_ID, t2.BANK_ID
;

  --------------------------------------------------------
  UPDATE DWKR_02.REPORT
  SET FINISH_TIME = SYSTIMESTAMP
  WHERE REPORT_ID = L_REPORT_ID;

  COMMIT;
  
  OUT_REPORT_ID := L_REPORT_ID;

  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' OUT_REPORT_ID = ' || OUT_REPORT_ID);
  DWKR_02.PROC_LOG_REPORT(FILE_NAME => '_DWKR_02.REPORT_FS10.PROC_FS10',LOG_STR => SYSTIMESTAMP||' Finished');

END PROC_FS10;


