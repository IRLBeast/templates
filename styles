def get_messages(request, db_type="main", default_schema="RTGX"):

    conn = get_connection(db_type)
    schema = get_schema(request, default_schema)

    sql = f'''
        SELECT
            "IdMessageInMX",
            "IdMessageIn",
            "TmIn",
            "CdErrorIn",
            "BizSvc",
            "BizMsgIdr",
            "MsgDefIdr",
            "NrBankSender",
            "CdAuthSender",
            "NrBankReceiver",
            "CdAuthReceiver"
        FROM {schema}."MessageInMX"
        ORDER BY "TmIn" DESC
        FETCH FIRST 50 ROWS ONLY
    '''

    print("=" * 80)
    print("GET MESSAGES")
    print("DB TYPE:", db_type)
    print("REQUEST SCHEMA:", request.GET.get("schema"))
    print("SELECTED SCHEMA:", schema)
    print("SQL:")
    print(sql)
    print("=" * 80)

    stmt = ibm_db.prepare(conn, sql)

    if not stmt:
        error = ibm_db.stmt_errormsg()

        print("!!! DB2 PREPARE ERROR !!!")
        print(error)
        print("=" * 80)

        ibm_db.close(conn)

        return JsonResponse({
            "error": error
        }, status=500)

    if not ibm_db.execute(stmt):
        error = ibm_db.stmt_errormsg()

        print("!!! DB2 EXECUTE ERROR !!!")
        print(error)
        print("=" * 80)

        ibm_db.close(conn)

        return JsonResponse({
            "error": error
        }, status=500)

    headers = [
        ibm_db.field_name(stmt, i)
        for i in range(ibm_db.num_fields(stmt))
    ]

    rows = []

    while ibm_db.fetch_row(stmt):
        row = {}

        for i, h in enumerate(headers):
            value = ibm_db.result(stmt, i)

            if hasattr(value, "isoformat"):
                value = value.isoformat()

            row[h] = value

        rows.append(row)

    print("ROWS RECEIVED:", len(rows))
    print("=" * 80)

    ibm_db.close(conn)

    return JsonResponse(rows, safe=False)