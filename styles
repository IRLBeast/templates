from pathlib import Path
from uuid import uuid4

from django.conf import settings
from django.shortcuts import render

from .smp_file_send import prepare_pacs008
from .mq_sender import send_xml_messages
from .smp_db import get_connection, wait_for_control_code

import ibm_db


def smp_sender(request):
    results = []

    if request.method == "POST":
        uploaded_files = request.FILES.getlist("xml_files")

        if not uploaded_files:
            return render(
                request,
                "smp/smp_sender.html",
                {
                    "error": "Выберите хотя бы один XML-файл.",
                    "results": [],
                },
            )

        output_dir = Path(settings.MEDIA_ROOT) / "prepared_smp"
        output_dir.mkdir(parents=True, exist_ok=True)

        prepared_messages = []

        # Создаём отдельный результат для каждого файла.
        for index, uploaded_file in enumerate(uploaded_files):
            item = {
                "filename": uploaded_file.name,
                "status": "Не отправлен",
                "error": "",
                "msg_id": None,
                "control_code": "",
                "control_description": "Ожидает отправки",
                "schema": "",
                "output_name": "",
            }

            try:
                xml_text = uploaded_file.read().decode("utf-8-sig")

                prepared_xml, ids = prepare_pacs008(
                    xml_text,
                    counter=index,
                )

                item["msg_id"] = ids["MsgId"]

                original_name = Path(uploaded_file.name).stem
                output_name = (
                    f"{original_name}_{uuid4().hex[:8]}_prepared.xml"
                )

                output_path = output_dir / output_name
                output_path.write_text(
                    prepared_xml,
                    encoding="utf-8",
                )

                item["output_name"] = output_name

                # Запоминаем индекс исходного результата,
                # чтобы не перепутать файлы при отправке.
                prepared_messages.append({
                    "result_index": len(results),
                    "xml": prepared_xml,
                    "msg_id": ids["MsgId"],
                })

            except Exception as exc:
                item["status"] = "Ошибка подготовки"
                item["error"] = (
                    f"{type(exc).__name__}: {exc}"
                )
                item["control_description"] = (
                    "Сообщение не отправлено"
                )

            results.append(item)

        # Отправляем все XML, которые удалось подготовить.
        if prepared_messages:
            send_results = send_xml_messages([
                item["xml"]
                for item in prepared_messages
            ])

            for prepared, send_result in zip(
                prepared_messages,
                send_results,
            ):
                item = results[prepared["result_index"]]

                if not send_result["success"]:
                    item["status"] = "Ошибка отправки"
                    item["error"] = send_result["error"]
                    item["control_description"] = (
                        "Сообщение не отправлено"
                    )
                    continue

                item["status"] = "Отправлено"
                item["control_description"] = (
                    "Ожидается результат обработки"
                )

        # Ищем коды контроля только для отправленных сообщений.
        sent_items = [
            (item, prepared)
            for item in results
            for prepared in prepared_messages
            if (
                prepared["result_index"] < len(results)
                and results[prepared["result_index"]] is item
                and item["status"] == "Отправлено"
            )
        ]

        if sent_items:
            conn = None

            try:
                conn = get_connection(db_type="smp")

                for item, prepared in sent_items:
                    msg_id = prepared["msg_id"]

                    if not msg_id:
                        item["control_description"] = (
                            "Нет MsgId для поиска"
                        )
                        continue

                    try:
                        control = wait_for_control_code(
                            conn,
                            msg_id,
                            timeout=20,
                            interval=2,
                        )

                        item["control_code"] = (
                            control["code"] or ""
                        )
                        item["control_description"] = (
                            control["description"]
                        )
                        item["schema"] = (
                            control["schema"] or ""
                        )

                    except Exception as exc:
                        item["control_description"] = (
                            "Не удалось получить результат из DB2"
                        )
                        item["error"] = (
                            f"Ошибка проверки DB2: "
                            f"{type(exc).__name__}: {exc}"
                        )

            except Exception as exc:
                # Отправка в MQ уже могла завершиться успешно.
                # Ошибка подключения к DB2 не должна менять
                # статус отправки.
                for item, _ in sent_items:
                    item["control_description"] = (
                        "Не удалось подключиться к DB2"
                    )
                    item["error"] = (
                        f"Ошибка подключения к DB2: "
                        f"{type(exc).__name__}: {exc}"
                    )

            finally:
                if conn is not None:
                    try:
                        ibm_db.close(conn)
                    except Exception:
                        pass

    return render(
        request,
        "smp/smp_sender.html",
        {
            "results": results,
        },
    )



