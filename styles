<div id="customModal" class="custom-modal" style="display: block;">
    <div class="custom-modal-content">
        <span class="custom-close">?</span>
        <h3 id="customModalTitle">Message text:</h3>
        <div id="customModalContent" class="modal-content-container">
            <div class="modal-content-wrapper">
                <div class="modal-text">
                    <p>
                        Message
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>


modal.js:
function initModal() {
    const modal = document.getElementById('customModal');
    const modalTitle = document.getElementById('customModalTitle');
    const modalContent = document.getElementById('customModalContent');
    
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('modal-btn')) {
            e.preventDefault();
            modalTitle.innerHTML = e.target.getAttribute('data-title');
            modalContent.innerHTML = e.target.getAttribute('data-content');
            modal.style.display = 'block';
            document.body.style.overflow = 'hidden';
        }
        
        if (e.target.classList.contains('custom-close') || 
            e.target.classList.contains('custom-close-btn') ||
            e.target === modal) {
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }
    });
}

if (document.readyState === 'complete') {
    initModal();
} else {
    document.addEventListener('DOMContentLoaded', initModal);
    window.addEventListener('load', initModal);
}