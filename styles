import os
import requests
import base64
from dotenv import load_dotenv

load_dotenv()

def test_get_pass_exp():
    headers = {
        "username": base64.b64encode(os.getenv("USERNAME").encode()).decode(),
        "password": base64.b64encode(os.getenv("PASSWORD").encode()).decode()
    }
    
    response = requests.get(
        f"{os.getenv('BASE_URL')}/login",
        headers=headers,
    )
    
    print(response.status_code)
    print('\n', response.text)