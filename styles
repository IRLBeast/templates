import os
import pymqi
import re


os.environ["MQCHLLIB"] = r"C:\Program Files\IBM\MQ"
os.environ["MQCHLTAB"] = "amqclchl.TAB"

QM_NAME = "MQ10"
QUEUE_NAME = "MX.IPSSRV01.FROM_PAY.LQ"


def send_xml_messages(messages: list[str]) -> list[dict]:

    results = []

    qmgr = None
    queue = None

    try:
        qmgr = pymqi.connect(QM_NAME)
        queue = pymqi.Queue(qmgr, QUEUE_NAME)

        for index, xml in enumerate(messages, start=1):
            try:
                queue.put(xml.encode("utf-8"))

                results.append({
                    "index": index,
                    "success": True,
                    "error": "",
                })

            except Exception as exc:
                results.append({
                    "index": index,
                    "success": False,
                    "error": f"{type(exc).__name__}: {exc}",
                })

    except Exception as exc:
        error = f"{type(exc).__name__}: {exc}"

        for index in range(len(results) + 1, len(messages) + 1):
            results.append({
                "index": index,
                "success": False,
                "error": error,
            })

    finally:
        if queue is not None:
            try:
                queue.close()
            except Exception:
                pass

        if qmgr is not None:
            try:
                qmgr.disconnect()
            except Exception:
                pass

    return results

def get_optional_tag_value(
    xml_text: str,
    tag_name: str
) -> str | None:
    pattern = (
        rf"<(?:\w+:)?{tag_name}>"
        rf"\s*([^<]*?)\s*"
        rf"</(?:\w+:)?{tag_name}>"
    )

    match = re.search(pattern, xml_text)

    if not match:
        return None

    return match.group(1).strip()