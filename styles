import pymqi


# Настройки IBM MQ
os.environ["MQCHLLIB"] = r"C:\ProgramData\IBM\MQ"
os.environ["MQCHLTAB"] = "amqclchl.TAB"

QM_NAME = "MQ10"
QUEUE_NAME = "MX.IPSSRV01.FROM_PAY.LQ"


def send_xml_messages(messages: list[str]) -> list[dict]:
    """
    Отправляет несколько XML-сообщений в одну очередь.

    messages — список XML-строк.

    Возвращает результат для каждого сообщения.
    """

    results = []

    qmgr = None
    queue = None

    try:
        qmgr = pymqi.connect(QM_NAME)
        queue = pymqi.Queue(qmgr, QUEUE_NAME)

        for index, xml in enumerate(messages, start=1):
            try:
                queue.put(xml.encode("utf-8"))

                results.append({
                    "index": index,
                    "success": True,
                    "error": "",
                })

            except Exception as exc:
                results.append({
                    "index": index,
                    "success": False,
                    "error": f"{type(exc).__name__}: {exc}",
                })

    except Exception as exc:
        error = f"{type(exc).__name__}: {exc}"

        # Если подключение или открытие очереди не удалось,
        # сообщения не были отправлены.
        for index in range(len(results) + 1, len(messages) + 1):
            results.append({
                "index": index,
                "success": False,
                "error": error,
            })

    finally:
        if queue is not None:
            try:
                queue.close()
            except Exception:
                pass

        if qmgr is not None:
            try:
                qmgr.disconnect()
            except Exception:
                pass

    return results





from pathlib import Path
from uuid import uuid4

from django.conf import settings
from django.shortcuts import render

from .smp_file_send import prepare_pacs008
from .mq_sender import send_xml_messages


def smp_sender(request):
    results = []

    if request.method == "POST":
        uploaded_files = request.FILES.getlist("xml_files")

        if not uploaded_files:
            return render(request, "smp/smp_sender.html", {
                "error": "Выберите хотя бы один XML-файл.",
                "results": [],
            })

        prepared_messages = []
        output_dir = Path(settings.MEDIA_ROOT) / "prepared_smp"
        output_dir.mkdir(parents=True, exist_ok=True)

        # Сначала подготавливаем все файлы.
        for index, uploaded_file in enumerate(uploaded_files):
            try:
                xml_text = uploaded_file.read().decode("utf-8-sig")

                # counter уникален для каждого файла в этой пачке.
                prepared_xml, ids = prepare_pacs008(
                    xml_text,
                    counter=index,
                )

                # Создаем уникальное имя, чтобы файлы
                # с одинаковыми названиями не перезаписывались.
                original_name = Path(uploaded_file.name).stem
                output_name = (
                    f"{original_name}_{uuid4().hex[:8]}_prepared.xml"
                )
                output_path = output_dir / output_name

                output_path.write_text(
                    prepared_xml,
                    encoding="utf-8",
                )

                prepared_messages.append({
                    "filename": uploaded_file.name,
                    "prepared_xml": prepared_xml,
                    "output_name": output_name,
                    "ids": ids,
                })

            except Exception as exc:
                results.append({
                    "filename": uploaded_file.name,
                    "success": False,
                    "error": (
                        f"Ошибка подготовки: "
                        f"{type(exc).__name__}: {exc}"
                    ),
                    "ids": None,
                })

        # Отправляем только успешно подготовленные XML.
        if prepared_messages:
            send_results = send_xml_messages([
                item["prepared_xml"]
                for item in prepared_messages
            ])

            for item, send_result in zip(
                prepared_messages,
                send_results,
            ):
                results.append({
                    "filename": item["filename"],
                    "success": send_result["success"],
                    "error": send_result["error"],
                    "ids": item["ids"],
                    "output_name": item["output_name"],
                })

    return render(request, "smp/smp_sender.html", {
        "results": results,
    })







