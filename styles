def handle_session_modal_advanced(driver):

    max_wait = 3  # Максимальное время ожидания окна
    
    try:
        # Ожидаем появления текста окна
        WebDriverWait(driver, max_wait).until(
            EC.text_to_be_present_in_element((By.TAG_NAME, "body"), 
                                           "Вход в систему уже осуществлен")
        )
        
        print("Обнаружено окно дублирующей сессии")
        
        annul_button = driver.find_element(By.ID, "form-popup-confirm")
        annul_button.click()
        print("Нажата кнопка 'Аннулировать'")
        
        return True
        
    except TimeoutException:
        print(f"Окно дублирующей сессии не появилось в течение {max_wait} секунд")
        return False
    except Exception as e:
        print(f"Неожиданная ошибка при проверке окна: {e}")
        return False