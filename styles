import re
from datetime import datetime


def generate_message_id(
    original_id: str,
    message_type: str,
    counter: int,
    timestamp: datetime | None = None,
) -> str:
    """
    Генерирует ID по логике старого bips.exe.

    Формат:

        первые 7 символов исходного ID
        + YYYYMMDDHHMMSS
        + тип ID
        + счетчик из 7 цифр

    Например:

        ABC123420260925104200MP80000000
    """

    if len(original_id) < 7:
        raise ValueError(
            f"Исходный ID должен содержать минимум 7 символов: {original_id!r}"
        )

    if len(message_type) != 3:
        raise ValueError(
            f"Тип ID должен содержать 3 символа: {message_type!r}"
        )

    if counter < 0:
        raise ValueError("Счетчик не может быть отрицательным")

    if timestamp is None:
        timestamp = datetime.now()

    prefix = original_id[:7]
    current_datetime = timestamp.strftime("%Y%m%d%H%M%S")
    counter_text = f"{counter:07d}"

    return (
        prefix
        + current_datetime
        + message_type
        + counter_text
    )


def get_tag_value(xml_text: str, tag_name: str) -> str | None:
    """
    Получает значение первого XML-тега.

    Поддерживает как:

        <MsgId>...</MsgId>

    так и namespace prefix:

        <ns:MsgId>...</ns:MsgId>
    """

    pattern = (
        rf"<(?:\w+:)?{tag_name}>"
        rf"\s*([^<]*)\s*"
        rf"</(?:\w+:)?{tag_name}>"
    )

    match = re.search(pattern, xml_text)

    if not match:
        return None

    return match.group(1).strip()


def replace_tag_value(
    xml_text: str,
    tag_name: str,
    new_value: str,
) -> str:
    """
    Заменяет содержимое всех найденных тегов tag_name.

    Например:

        <MsgId>OLD</MsgId>

    превращается в:

        <MsgId>NEW</MsgId>
    """

    pattern = (
        rf"(<(?:\w+:)?{tag_name}>)[^<]*"
        rf"(</(?:\w+:)?{tag_name}>)"
    )

    return re.sub(
        pattern,
        lambda match: (
            match.group(1)
            + new_value
            + match.group(2)
        ),
        xml_text,
    )


def prepare_pacs008(
    xml_text: str,
    counter: int = 0,
    timestamp: datetime | None = None,
) -> tuple[str, dict[str, str]]:
    """
    Подготавливает один pacs.008 по логике старого bips.exe.

    Меняет:

        MsgId
        InstrId
        TxId (если присутствует)

    Возвращает:

        (измененный XML, словарь созданных ID)
    """

    if timestamp is None:
        timestamp = datetime.now()

    # Старый bips.exe брал исходный MsgId.
    original_msg_id = get_tag_value(xml_text, "MsgId")

    if not original_msg_id:
        raise ValueError("Тег MsgId не найден")

    # В старом приложении первые 7 символов
    # исходного MsgId становятся префиксом.
    prefix = original_msg_id[:7]

    # ---------------------------------------------------------
    # MsgId
    # ---------------------------------------------------------

    msg_id = generate_message_id(
        original_id=original_msg_id,
        message_type="MP8",
        counter=counter,
        timestamp=timestamp,
    )

    xml_text = replace_tag_value(
        xml_text,
        "MsgId",
        msg_id,
    )

    # ---------------------------------------------------------
    # InstrId
    # ---------------------------------------------------------

    original_instr_id = get_tag_value(
        xml_text,
        "InstrId",
    )

    instr_id = None

    if original_instr_id is not None:
        instr_id = generate_message_id(
            original_id=original_instr_id,
            message_type="IP8",
            counter=counter,
            timestamp=timestamp,
        )

        xml_text = replace_tag_value(
            xml_text,
            "InstrId",
            instr_id,
        )

    # ---------------------------------------------------------
    # TxId
    # ---------------------------------------------------------

    original_tx_id = get_tag_value(
        xml_text,
        "TxId",
    )

    tx_id = None

    if original_tx_id is not None:
        tx_id = generate_message_id(
            original_id=original_tx_id,
            message_type="TP8",
            counter=counter,
            timestamp=timestamp,
        )

        xml_text = replace_tag_value(
            xml_text,
            "TxId",
            tx_id,
        )

    # Возвращаем также созданные ID.
    ids = {
        "MsgId": msg_id,
    }

    if instr_id is not None:
        ids["InstrId"] = instr_id

    if tx_id is not None:
        ids["TxId"] = tx_id

    return xml_text, ids


def prepare_pacs008_messages(
    xml_text: str,
    number_of_messages: int,
) -> list[tuple[str, dict[str, str]]]:
    """
    Создает несколько pacs.008.

    Счетчик начинается с 0, как в старом bips.exe:

        0000000
        0000001
        0000002
        ...

    """

    if number_of_messages <= 0:
        raise ValueError(
            "Количество сообщений должно быть больше 0"
        )

    messages = []

    for counter in range(number_of_messages):
        # В старом C# DateTime.Now вызывается внутри цикла,
        # поэтому для каждого сообщения берем текущее время.
        timestamp = datetime.now()

        prepared_xml, ids = prepare_pacs008(
            xml_text=xml_text,
            counter=counter,
            timestamp=timestamp,
        )

        messages.append(
            (prepared_xml, ids)
        )

    return messages





