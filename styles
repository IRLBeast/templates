pip install pymqi

import pymqi

QMGR = "QM1"
CHANNEL = "DEV.APP.SVRCONN"
HOST = "192.168.1.100"
PORT = "1414"
QUEUE = "INPUT.QUEUE"

conn_info = f"{HOST}({PORT})"

cd = pymqi.CD()
cd.ChannelName = CHANNEL
cd.ConnectionName = conn_info
cd.ChannelType = pymqi.CMQC.MQCHT_CLNTCONN
cd.TransportType = pymqi.CMQC.MQXPT_TCP

qmgr = pymqi.QueueManager(None)
qmgr.connect_with_options(QMGR, cd=cd)

queue = pymqi.Queue(qmgr, QUEUE)

with open("message.xml", "r", encoding="utf-8") as f:
    xml = f.read()

queue.put(xml)

print("XML успешно отправлен")

queue.close()
qmgr.disconnect()




Если получатель ожидает кодировку UTF-8, лучше явно указать параметры сообщения:
pmo = pymqi.PMO()
md = pymqi.MD()

md.Format = pymqi.CMQC.MQFMT_STRING
md.CodedCharSetId = 1208  # UTF-8
md.Encoding = pymqi.CMQC.MQENC_NATIVE

queue.put(xml, md, pmo)



нужно знать:
Queue Manager (например QM1);
Channel (например DEV.APP.SVRCONN);
Host;
Port (обычно 1414);
Имя очереди, в которую нужно отправлять XML;
нужен ли логин/пароль;
используется ли TLS.