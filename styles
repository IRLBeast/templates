import os
from pathlib import Path
import pymqi


os.environ["MQCHLLIB"] = r"C:\Program Files\IBM\MQ"
os.environ["MQCHLTAB"] = "amqclchl.TAB"

QM_NAME = "MQ10"
QUEUE_NAME = "MX.IPSSRV01.FROM_PAY.LQ"

XML_FILE = Path(r"D:\autotest\docs\смп_Z00_3012_3600.xml")


def send_xml():
    xml = XML_FILE.read_text(encoding="utf-8")

    try:
        qmgr = pymqi.connect(QM_NAME)

        queue = pymqi.Queue(qmgr, QUEUE_NAME)

        queue.put(xml.encode("utf-8"))

        print("XML успешно отправлен!")

    except pymqi.MQMIError as e:
        print("Ошибка IBM MQ")
        print("Reason code:", e.reason)
        print(e)

    except Exception as e:
        print("Ошибка Python")
        print(type(e).__name__, e)

if __name__ == "__main__":
    send_xml()