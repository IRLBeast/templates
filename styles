import os
import ibm_db

def get_connection():
    conn_str = (
        f"DATABASE={os.getenv('DB_NAME')};"
        f"HOSTNAME={os.getenv('DB_HOST')};"
        f"PORT={os.getenv('DB_PORT')};"
        "PROTOCOL=TCPIP;"
        f"UID={os.getenv('DB_USER')};"
        f"PWD={os.getenv('DB_PASSWORD')};"
    )

    return ibm_db.connect(conn_str, "", "")