<script>

function runSelectedTests() {

    const selected = [];

    document.querySelectorAll(
        ".ks-cboxtags input:checked"
    ).forEach(cb => {
        selected.push(cb.value);
    });

    if (selected.length === 0) {
        alert("Select at least one test");
        return;
    }

    document.getElementById("output").textContent =
        "Running tests...";

    fetch("/run-tests/", {

        method: "POST",

        headers: {
            "Content-Type": "application/json",
        },

        body: JSON.stringify({
            tests: selected
        })

    })

    .then(res => res.json())

    .then(data => {

        let output = "";

        if (data.text_report) {
            output += data.text_report;
        }

        if (data.stderr) {
            output += "\n\nERRORS:\n" + data.stderr;
        }

        document.getElementById("output").textContent = output;
    });
}

</script>




<script>
function copyReport() {
    const text = document.getElementById("output").textContent;
    navigator.clipboard.writeText(text);
}
</script>

<script>
function runTest(testName) {
    document.getElementById("output").textContent = "Running test...";

    fetch(`/run-test/?test=${testName}`)
        .then(res => res.json())
        .then(data => {
            let output = "";

            if (data.text_report) {
                output += data.text_report;
            }

            if (data.stderr) {
                output += "\n\nERRORS:\n" + data.stderr;
            }

            if (data.stdout) {
                output += "\n\nLOGS:\n" + data.stdout;
            }

            document.getElementById("output").textContent = output;
        })
        .catch(err => {
            document.getElementById("output").textContent = "Error: " + err;
        });
}
</script>