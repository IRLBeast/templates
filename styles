import os
import time

import ibm_db


# Расшифровка кодов контроля.
# Позже можно дополнять этот словарь.
CONTROL_CODE_DESCRIPTIONS = {
    "Z00": "успешно",
    "F3": "ошибка",
}

# Список разрешённых схем.
# Имена схем нельзя передавать как обычные SQL-параметры,
# поэтому используем только фиксированный список.
SCHEMAS = ("BIKL", "SMKL")


def get_connection(db_type="main"):
    if db_type == "smp":
        database = os.getenv("SMP_DB_MAINFRAME_2B_NAME")
        host = os.getenv("SMP_DB_HOST")
        port = os.getenv("SMP_DB_PORT")
        user = os.getenv("DB_USER_SMP")
    else:
        raise ValueError(
            f"Неизвестный тип подключения к БД: {db_type}"
        )

    password = os.getenv("DB_PASSWORD_BISS")

    required_settings = {
        "SMP_DB_MAINFRAME_2B_NAME": database,
        "SMP_DB_HOST": host,
        "SMP_DB_PORT": port,
        "DB_USER_SMP": user,
        "DB_PASSWORD_BISS": password,
    }

    missing = [
        name
        for name, value in required_settings.items()
        if not value
    ]

    if missing:
        raise ValueError(
            "Не заданы переменные окружения: "
            + ", ".join(missing)
        )

    conn_str = (
        f"DATABASE={database};"
        f"HOSTNAME={host};"
        f"PORT={port};"
        "PROTOCOL=TCPIP;"
        f"UID={user};"
        f"PWD={password};"
    )

    return ibm_db.connect(conn_str, "", "")


def find_control_code(conn, msg_id):
    """
    Ищет CdErrorIn сначала в BIKL, затем в SMKL.

    Возвращает:
        {
            "code": "Z00",
            "description": "успешно",
            "schema": "BIKL",
            "found": True,
        }

    Если запись не найдена в обеих схемах:
        {
            "code": None,
            "description": "Результат пока не найден",
            "schema": None,
            "found": False,
        }
    """

    if not msg_id:
        return {
            "code": None,
            "description": "Нет MsgId для поиска",
            "schema": None,
            "found": False,
        }

    for schema in SCHEMAS:
        # schema берётся только из SCHEMAS,
        # а msg_id передаётся параметром.
        sql = (
            f'SELECT "CdErrorIn" '
            f'FROM "{schema}"."MessageInMX" '
            f'WHERE "BizMsgIdr" = ?'
        )

        stmt = ibm_db.prepare(conn, sql)

        ibm_db.bind_param(stmt, 1, msg_id)

        if not ibm_db.execute(stmt):
            raise RuntimeError(
                f"Не удалось выполнить запрос к схеме {schema}"
            )

        row = ibm_db.fetch_assoc(stmt)

        if row:
            code = row.get("CDERRORIN")

            # В зависимости от версии драйвера ключ может
            # иметь другой регистр.
            if code is None:
                code = row.get("CdErrorIn")

            if code is not None:
                code = str(code).strip()

            return {
                "code": code,
                "description": CONTROL_CODE_DESCRIPTIONS.get(
                    code,
                    "Расшифровка не задана",
                ),
                "schema": schema,
                "found": True,
            }

    return {
        "code": None,
        "description": "Результат пока не найден",
        "schema": None,
        "found": False,
    }


def wait_for_control_code(
    conn,
    msg_id,
    timeout=20,
    interval=2,
):
    """
    Повторяет поиск, пока не появится запись или
    не истечёт timeout.

    По умолчанию ждём до 20 секунд,
    повторяя запрос каждые 2 секунды.
    """

    deadline = time.monotonic() + timeout

    while True:
        result = find_control_code(conn, msg_id)

        if result["found"]:
            return result

        if time.monotonic() >= deadline:
            return result

        time.sleep(interval)




