import re
from datetime import datetime


def update_xml_dates(xml_text: str) -> str:
    now = datetime.now()

    current_date = now.strftime("%Y%m%d")
    current_datetime = now.strftime("%Y-%m-%dT%H:%M:%S+03:00")
    current_date_iso = now.strftime("%Y-%m-%d")

    # BizMsgIdr, MsgId, InstrId
    # Заменяем только дату внутри идентификатора.
    for tag_name in ("BizMsgIdr", "MsgId", "InstrId"):
        pattern = rf"(<(?:\w+:)?{tag_name}>\s*[^<]{{7}})\d{{8}}([^<]*</(?:\w+:)?{tag_name}>)"

        xml_text = re.sub(
            pattern,
            rf"\g<1>{current_date}\g<2>",
            xml_text,
            count=0
        )

    # CreDt
    xml_text = re.sub(
        r"(<(?:\w+:)?CreDt>)[^<]*(</(?:\w+:)?CreDt>)",
        rf"\g<1>{current_datetime}\g<2>",
        xml_text
    )

    # CreDtTm
    xml_text = re.sub(
        r"(<(?:\w+:)?CreDtTm>)[^<]*(</(?:\w+:)?CreDtTm>)",
        rf"\g<1>{current_datetime}\g<2>",
        xml_text
    )

    # IntrBkSttlmDt
    xml_text = re.sub(
        r"(<(?:\w+:)?IntrBkSttlmDt>)[^<]*(</(?:\w+:)?IntrBkSttlmDt>)",
        rf"\g<1>{current_date_iso}\g<2>",
        xml_text
    )

    return xml_text