import subprocess
import uuid
import os
import json
import sys


TESTS_MAP = {

    "kr_legal":
        "tests/credit_register/test_legal_users.py",

    "kr_reports":
        "tests/credit_register/test_reports.py",

    "smp_login":
        "tests/smp/test_login.py",

}


BROWSER_ARGS = {

    "chrome": [
        "--browser",
        "chromium"
    ],

    "firefox": [
        "--browser",
        "firefox"
    ],

    "edge": [
        "--browser",
        "chromium",
        "--browser-channel",
        "msedge"
    ],

}


def run_pytest(test_names, browsers):

    run_id = str(uuid.uuid4())

    os.makedirs("reports", exist_ok=True)

    selected_paths = []

    for test_name in test_names:

        if test_name in TESTS_MAP:

            selected_paths.append(
                TESTS_MAP[test_name]
            )

    if not selected_paths:

        return {
            "error": "No valid tests selected"
        }


    results = {}

    all_stdout = []
    all_stderr = []


    for browser in browsers:

        if browser not in BROWSER_ARGS:

            results[browser] = {
                "error": f"Unsupported browser: {browser}"
            }

            continue


        report_file = (
            f"reports/{run_id}_{browser}.json"
        )


        command = [
            sys.executable,
            "-m",
            "pytest",

            *selected_paths,

            "-v",
            "-s",

            *BROWSER_ARGS[browser],

            "--json-report",
            f"--json-report-file={report_file}"
        ]


        print(
            f"\nRunning tests in {browser}:"
        )

        print(
            " ".join(command)
        )


        result = subprocess.run(
            command,
            capture_output=True,
            text=True
        )


        report_data = {}


        if os.path.exists(report_file):

            with open(
                report_file,
                "r",
                encoding="utf-8"
            ) as f:

                report_data = json.load(f)


        text_report = build_text_report(
            report_data,
            browser
        )


        results[browser] = {

            "stdout": result.stdout,

            "stderr": result.stderr,

            "report": report_data,

            "text_report": text_report

        }


        all_stdout.append(
            f"\n===== {browser.upper()} =====\n"
            + result.stdout
        )


        if result.stderr:

            all_stderr.append(
                f"\n===== {browser.upper()} =====\n"
                + result.stderr
            )


    return {

        "run_id": run_id,

        "results": results,

        # Для совместимости
        # с текущим JS
        "stdout": "\n".join(all_stdout),

        "stderr": "\n".join(all_stderr),

        "text_report": build_combined_text_report(
            results
        )

    }


def build_text_report(
    report_data,
    browser
):

    summary = report_data.get(
        "summary",
        {}
    )

    tests = report_data.get(
        "tests",
        []
    )


    lines = []

    lines.append(
        f"===== {browser.upper()} ====="
    )

    lines.append("")

    lines.append(
        f"Passed: {summary.get('passed', 0)}"
    )

    lines.append(
        f"Failed: {summary.get('failed', 0)}"
    )

    lines.append(
        f"Skipped: {summary.get('skipped', 0)}"
    )

    lines.append("")

    lines.append("DETAILS:")


    for test in tests:

        nodeid = test.get(
            "nodeid",
            "unknown"
        )

        outcome = test.get(
            "outcome",
            "unknown"
        )


        lines.append(
            f"- {nodeid} → {outcome.upper()}"
        )


        # stdout конкретного теста
        for section in (
            "setup",
            "call",
            "teardown"
        ):

            data = test.get(
                section,
                {}
            )

            stdout = data.get(
                "stdout",
                ""
            )

            if stdout:

                lines.append("")
                lines.append("LOGS:")
                lines.append(stdout)


    return "\n".join(lines)


def build_combined_text_report(
    results
):

    lines = []


    for browser, data in results.items():

        text_report = data.get(
            "text_report",
            ""
        )

        if text_report:

            lines.append(
                text_report
            )

            lines.append("")


    return "\n".join(lines)