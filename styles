from playwright.sync_api import TimeoutError


def handle_session_modal(page):

    try:
        page.get_by_text(
            "already in system",
            exact=False
        ).wait_for(timeout=3000)

        page.locator("#form-popup-confirm").click()

        print("Pressed 'annul' button")

        return True

    except TimeoutError:
        print("Modal did not appear")

        return False

    except Exception as e:
        print(f"Unexpected error: {e}")

        return False

