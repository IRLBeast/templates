from datetime import datetime
import xml.etree.ElementTree as ET


def update_xml_dates(xml_text: str) -> str:
    """
    Обновляет даты и идентификаторы в XML перед отправкой.

    Изменяет:
        BizMsgIdr  — заменяет первые 8 цифр даты внутри ID
        MsgId      — заменяет первые 8 цифр даты внутри ID
        InstrId    — заменяет первые 8 цифр даты внутри ID
        CreDt      — текущая дата и время
        CreDtTm    — текущая дата и время
        IntrBkSttlmDt — текущая дата
    """

    now = datetime.now()

    current_date = now.strftime("%Y%m%d")
    current_datetime = now.strftime("%Y-%m-%dT%H:%M:%S+03:00")

    root = ET.fromstring(xml_text)

    # Теги, внутри которых дата находится как часть идентификатора.
    id_tags = {
        "BizMsgIdr",
        "MsgId",
        "InstrId",
    }

    for element in root.iter():
        tag_name = element.tag.split("}")[-1]

        if tag_name in id_tags and element.text:
            # В твоих ID дата находится после первых 7 символов:
            #
            # 345ABSB20230120...
            #       ^^^^^^^^
            #
            # Поэтому сохраняем всё до даты и всё после даты.
            value = element.text

            if len(value) >= 15:
                element.text = value[:7] + current_date + value[15:]

        elif tag_name in {"CreDt", "CreDtTm"}:
            element.text = current_datetime

        elif tag_name == "IntrBkSttlmDt":
            element.text = now.strftime("%Y-%m-%d")

    return ET.tostring(
        root,
        encoding="unicode"
    )





