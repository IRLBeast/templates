          FROM  prm_dt_range,
                kd_end
                INNER JOIN
                DWKR_02.KD_ISP_LATE_REST7_AE_5Y lt7
                ON kd_end.BORR_ID = lt7.BORR_ID AND kd_end.KRED_DOG_ID = lt7.KRED_DOG_ID
          WHERE lt7.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
            AND (lt7.END_DATE IS NULL OR lt7.END_DATE >= prm_dt_range.DATE_BEGIN)
  
          UNION
  
          SELECT DISTINCT
              kd_end.BORR_ID,
              kd_end.KRED_DOG_ID,
              lt10.VALUTA_ID
          FROM  prm_dt_range,
                kd_end
                INNER JOIN
                DWKR_02.KD_ISP_LATE_REST10_AE_5Y lt10
                ON kd_end.BORR_ID = lt10.BORR_ID AND kd_end.KRED_DOG_ID = lt10.KRED_DOG_ID
          WHERE lt10.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
            AND (lt10.END_DATE IS NULL OR lt10.END_DATE >= prm_dt_range.DATE_BEGIN)
  
          UNION
  
          SELECT DISTINCT
              kd_end.BORR_ID,
              kd_end.KRED_DOG_ID,
              lt11.VALUTA_ID
          FROM  prm_dt_range,
                kd_end
                INNER JOIN
                DWKR_02.KD_ISP_LATE_REST11_AE_5Y lt11
                ON kd_end.BORR_ID = lt11.BORR_ID AND kd_end.KRED_DOG_ID = lt11.KRED_DOG_ID
          WHERE lt11.BEGIN_DATE <= prm_dt_range.DATE_BEGIN
