<q-dialog v-model="messageDialog">

    <q-card style="min-width:1000px; max-width:95vw;">

        <q-card-section class="row items-center">

            <div class="text-h6">
                Message text
            </div>

            <q-space />

            <q-btn
                icon="close"
                flat
                round
                dense
                v-close-popup
            />

        </q-card-section>

        <q-separator />

        <q-card-section style="max-height:70vh; overflow:auto;">

            <pre>{{ messageText }}</pre>

        </q-card-section>

    </q-card>

</q-dialog>