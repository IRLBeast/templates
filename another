attachContextMenu() {

    this.$nextTick(() => {

        const rows = document.querySelectorAll("tbody tr");

        rows.forEach((tr) => {

            tr.oncontextmenu = (e) => {

                e.preventDefault();

                const key = tr.getAttribute("data-row-key");

                this.selectedRow = this.data.find(
                    item => String(item.IdMessageInMX) === key
                );

                console.log(this.selectedRow);

                this.$refs.rowMenu.show(e);

            };

        });

    });

},