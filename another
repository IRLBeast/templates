attachContextMenu() {
    this.$nextTick(() => {

        const tbody = this.$el.querySelector("tbody");

        if (!tbody) {
            return;
        }

        // Чтобы не повесить обработчик дважды
        if (tbody._contextMenuAttached) {
            return;
        }

        tbody._contextMenuAttached = true;

        tbody.addEventListener("contextmenu", (e) => {

            const tr = e.target.closest("tr");

            if (!tr) {
                return;
            }

            e.preventDefault();

            this.selectedMessageId = tr.cells[0].innerText.trim();

            console.log("ID:", this.selectedMessageId);

            this.$refs.rowMenu.show(e);

        });

    });
}